#!/bin/bash

set -x

# cloud-init does not export this file; cron's pam_env does. Hooks are child processes.
set -a
source /etc/environment
set +a
if [[ -f /etc/profile.d/proxy.sh ]]; then
    source /etc/profile.d/proxy.sh
fi

# reset reboot_required.txt
echo -n "no" > ${BOOTSTRAP_DIR}/reboot_required.txt

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
source "${SCRIPT_DIR}/../common/bootstrap_common.sh"

{% include 'compute-node/_templates/scheduler_stop.jinja2' %}

{% with node_type = 'compute' %}
  {% include '_templates/linux/gpu_drivers.jinja2' %}
{% endwith %}

# a reboot may be required if GPU Drivers are installed.
REBOOT_REQUIRED=$(cat /root/bootstrap/reboot_required.txt)
if [[ "${REBOOT_REQUIRED}" == "yes" ]]; then
  reboot
  exit 0
else

  # user data customizations
  if [[ -f ${IDEA_CLUSTER_HOME}/${IDEA_MODULE_ID}/ami_builder/userdata_customizations.sh ]]; then
    /bin/bash ${IDEA_CLUSTER_HOME}/${IDEA_MODULE_ID}/ami_builder/userdata_customizations.sh >> ${IDEA_COMPUTE_NODE_AMI_BUILDER_LOGS_DIR}/userdata_customizations.log 2>&1 || exit 1
  else
    log_info "no userdata customizations"
  fi

  # clean-up: shared storage mounts
  {% for name, storage in context.config.get_config('shared-storage').items() %}
  {% if context.eval_shared_storage_scope(shared_storage=storage) %}
  remove_from_fstab "{{ storage.mount_dir }}"
  {% endif %}
  {% endfor %}

  # clean-up: instance storage mounts
  remove_from_fstab "/scratch"

  # clean-up
  rm -rf /var/tmp/* /tmp/* /var/crash/*
  rm -f /etc/udev/rules.d/70-persistent-net.rules
  grep -l "Created by cloud-init on instance boot automatically" /etc/sysconfig/network-scripts/ifcfg-* | xargs rm -f
  {% if context.config.get_string('scheduler.provider') == 'openpbs' %}
  systemctl disable pbs
  {% endif %}

  touch /var/lib/idea/bake-drivers.ok
  # ponytail: no ERR trap on compute (its templates are not audited for benign non-zero
  # exits); a stage that dies before here never tags and the backend times the bake out.
  # checks first (they read the stage markers and logs), then the identity scrub, then the
  # release marker; only the publish step may tag complete
  export AWS_INSTANCE_ID IDEA_COMPUTE_NODE_AMI_BUILDER_LOGS_DIR
  /bin/bash "${SCRIPT_DIR}/image_checks.sh" || exit 1
  if ! /bin/bash "${SCRIPT_DIR}/image_scrub.sh"; then
    /bin/bash "${SCRIPT_DIR}/image_checks.sh" --failed-scrub
    exit 1
  fi
  printf '%s\n' "${IDEA_MODULE_VERSION}" > /var/lib/idea/baked-release
  /bin/sync
  /bin/bash "${SCRIPT_DIR}/image_checks.sh" --publish || /bin/bash "${SCRIPT_DIR}/image_checks.sh" --failed-publish
fi
