# Begin: Compute OpenMPI
if [[ -x /opt/amazon/openmpi5/bin/mpirun ]]; then
  mkdir -p /opt/idea
  ln -sfn /opt/amazon/openmpi5 /opt/idea/openmpi5
  if [[ -x /opt/amazon/openmpi/bin/mpirun ]]; then
    ln -sfn /opt/amazon/openmpi /opt/idea/openmpi4
  fi

# Sort after EFA's zippy_efa.sh, which selects OpenMPI 4.
cat > /etc/profile.d/zz_idea_openmpi.sh <<'IDEA_OPENMPI_PROFILE'
case "${PATH:-}" in
  /opt/idea/openmpi5/bin:*) ;;
  *) export PATH="/opt/idea/openmpi5/bin:${PATH:-/usr/local/bin:/usr/bin:/bin}" ;;
esac
IDEA_OPENMPI_PROFILE
chmod 0644 /etc/profile.d/zz_idea_openmpi.sh
  idea_pbs_path='/opt/idea/openmpi5/bin:/bin:/usr/bin'
else
  idea_pbs_path='/bin:/usr/bin'
  rm -f /etc/profile.d/zz_idea_openmpi.sh
  for link in /opt/idea/openmpi{4,5}; do
    if [[ -L "${link}" ]]; then
      rm -f "${link}"
    fi
  done
fi || true
# MoM reads this file at start; rewrite only its PATH line, leaving the rest as written.
if [[ -f /var/spool/pbs/pbs_environment ]]; then
  awk -v path="PATH=${idea_pbs_path:-/bin:/usr/bin}" '/^PATH=/ { print path; next } { print }' /var/spool/pbs/pbs_environment > /var/spool/pbs/pbs_environment.idea \
    && cat /var/spool/pbs/pbs_environment.idea > /var/spool/pbs/pbs_environment
  rm -f /var/spool/pbs/pbs_environment.idea
fi || true
# End: Compute OpenMPI
