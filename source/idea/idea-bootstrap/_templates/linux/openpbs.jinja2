# Begin: Install OpenPBS
{% if context.base_os in ('amazonlinux2023', 'rhel8', 'rhel9', 'rhel10', 'rocky8', 'rocky9', 'rocky10', 'ubuntu2204', 'ubuntu2404', 'ubuntu2604') %}

function install_openpbs_dependencies() {
  OPENPBS_PKGS="{{ ' '.join(context.config.get_list('global-settings.package_config.openpbs.packages', default=[])) }}"
  {% if context.base_os in ('amazonlinux2023', 'rhel8', 'rhel9', 'rhel10', 'rocky8', 'rocky9', 'rocky10') %}
  package_transaction yum install -y --skip-broken $(echo ${OPENPBS_PKGS[*]})
  {% endif %}
  {% if context.base_os in ('ubuntu2204', 'ubuntu2404', 'ubuntu2604') %}
  # the build dependencies come from linux_packages.application_deb; this list adds to them
  OPENPBS_PKGS_DEB="{{ ' '.join(context.config.get_list('global-settings.package_config.openpbs.packages_deb', default=[])) }}"
  [[ -z "${OPENPBS_PKGS_DEB}" ]] || apt install -y ${OPENPBS_PKGS_DEB}
  {% endif %}
  {% include '_templates/linux/cjson_devel.jinja2' %}
}

function check_openpbs_installed() {
  local OPENPBS_VERSION=$1
  # check if already installed and is the correct version
  if [[ -f /opt/pbs/bin/qstat ]]; then
    local OPENPBS_INSTALLED_VERSION=$(/opt/pbs/bin/qstat --version | awk '{print $NF}')
    if [[ "${OPENPBS_INSTALLED_VERSION}" == "${OPENPBS_VERSION}" ]]; then
      log_info "OpenPBS is already installed. Version: ${OPENPBS_VERSION}"
      return 0
    fi
  fi
  return 1
}

# pbs_iff authenticates clients and needs setuid root; file staging uses scp (PBS_SCP), so
# pbs_rcp is an ordinary program. Applied on every path, also to an install the image carried.
function set_openpbs_modes() {
  chmod 4755 /opt/pbs/sbin/pbs_iff && chmod 0755 /opt/pbs/sbin/pbs_rcp \
    || { log_error "could not set the OpenPBS binary modes"; return 1; }
}

function compile_and_install_openpbs() {
  local OPENPBS_VERSION=$1
  local OPENPBS_WORK_DIR=$2

  pushd ${OPENPBS_WORK_DIR} || exit
  ./autogen.sh
  ./configure PBS_VERSION=${OPENPBS_VERSION} --prefix=/opt/pbs
  local NUM_PROCS=`nproc --all`
  local MAKE_FLAGS="-j${NUM_PROCS}"
  make ${MAKE_FLAGS}
  if ! make install ${MAKE_FLAGS}; then
    log_error "OpenPBS ${OPENPBS_VERSION} build failed, nothing was installed to /opt/pbs"
    popd
    return 1
  fi
  /opt/pbs/libexec/pbs_postinstall
  popd || exit
  set_openpbs_modes
}

function install_openpbs_release() {
  local OPENPBS_VERSION="{{ context.config.get_string('global-settings.package_config.openpbs.version', required=True) }}"

  # Check if already installed with correct version
  if check_openpbs_installed "${OPENPBS_VERSION}"; then
    set_openpbs_modes
    return
  fi

  install_openpbs_dependencies
  log_info "Installing OpenPBS version ${OPENPBS_VERSION} from release package..."

  local OPENPBS_URL="{{ context.config.get_string('global-settings.package_config.openpbs.url', required=True) }}"
  local OPENPBS_HASH="{{ context.config.get_string('global-settings.package_config.openpbs.checksum', required=True).lower().strip() }}"
  local OPENPBS_HASH_METHOD="{{ context.config.get_string('global-settings.package_config.openpbs.checksum_method', required=True).lower().strip() }}"
  local OPENPBS_TGZ="$(basename ${OPENPBS_URL})"
  local OPENPBS_WORK_DIR="/root/bootstrap/openpbs"

  # Download and verify
  mkdir -p "${OPENPBS_WORK_DIR}"
  pushd ${OPENPBS_WORK_DIR} || exit
  wget ${OPENPBS_URL}
  if [[ $(openssl ${OPENPBS_HASH_METHOD} ${OPENPBS_TGZ} | awk '{print $2}') != ${OPENPBS_HASH} ]]; then
    echo -e "FATAL ERROR: ${OPENPBS_HASH_METHOD} Checksum for OpenPBS failed. File may be compromised." > /etc/motd
    popd
    exit 1
  fi

  # Extract
  tar zxvf ${OPENPBS_TGZ}
  local EXTRACT_DIR="${OPENPBS_WORK_DIR}/openpbs-${OPENPBS_VERSION}"
  popd || exit

  # Compile and install
  compile_and_install_openpbs "${OPENPBS_VERSION}" "${EXTRACT_DIR}"
}

function check_openpbs_git_installed() {
  local OPENPBS_VERSION=$1
  local OPENPBS_COMMIT=$2
  check_openpbs_installed "${OPENPBS_VERSION}" || return 1
  # qstat --version does not change across commits of the same version; compare
  # the commit recorded at install time so a pin bump reaches existing nodes/AMIs
  local OPENPBS_INSTALLED_COMMIT=""
  if [[ -f /opt/pbs/.idea_openpbs_commit ]]; then
    OPENPBS_INSTALLED_COMMIT=$(cat /opt/pbs/.idea_openpbs_commit)
  fi
  if [[ "${OPENPBS_INSTALLED_COMMIT}" == "${OPENPBS_COMMIT}" ]]; then
    log_info "OpenPBS ${OPENPBS_VERSION} (commit ${OPENPBS_COMMIT}) is already installed."
    return 0
  fi
  return 1
}

function install_openpbs_git() {
  local OPENPBS_VERSION="{{ context.config.get_string('global-settings.package_config.openpbs.version', required=True) }}"
  local OPENPBS_COMMIT='{{ context.config.get_string('global-settings.package_config.openpbs.commit', required=True) | default('', true) | string | trim | replace("'", "'\\''") }}'

  # Check if already installed with correct version AND commit
  if check_openpbs_git_installed "${OPENPBS_VERSION}" "${OPENPBS_COMMIT}"; then
    set_openpbs_modes
    return
  fi

  install_openpbs_dependencies
  local OPENPBS_REPO_URL='{{ context.config.get_string('global-settings.package_config.openpbs.repo_url', required=True) | default('', true) | string | trim | replace("'", "'\\''") }}'
  local OPENPBS_WORK_DIR="/root/bootstrap/openpbs"

  log_info "Installing OpenPBS version ${OPENPBS_VERSION} from git commit ${OPENPBS_COMMIT}..."

  # Clone repository
  mkdir -p "${OPENPBS_WORK_DIR}"
  pushd ${OPENPBS_WORK_DIR} || exit
  rm -rf openpbs
  git clone "${OPENPBS_REPO_URL}" openpbs
  cd openpbs || exit
  # build only the commit the stored setting names: it may be a full or short hash, a tag or a
  # branch (a branch other than the default exists after a clone only as origin/<name>), so it is
  # resolved to a commit first; a failed clone, resolve or checkout must not build whatever is there
  local OPENPBS_RESOLVED OPENPBS_LOWER
  OPENPBS_LOWER=$(tr '[:upper:]' '[:lower:]' <<< "${OPENPBS_COMMIT}")
  OPENPBS_RESOLVED=$(git rev-parse --verify --quiet "${OPENPBS_COMMIT}^{commit}" 2> /dev/null \
    || git rev-parse --verify --quiet "refs/remotes/origin/${OPENPBS_COMMIT}^{commit}" 2> /dev/null \
    || git rev-parse --verify --quiet "${OPENPBS_LOWER}^{commit}" 2> /dev/null)
  # a hash is a pin; a branch or tag name can move, so the build is what it names today
  if [[ -n "${OPENPBS_RESOLVED}" && ! ( "${OPENPBS_LOWER}" =~ ^[0-9a-f]{7,40}$ && "${OPENPBS_RESOLVED}" == "${OPENPBS_LOWER}"* ) ]]; then
    log_warning "global-settings.package_config.openpbs.commit is ${OPENPBS_COMMIT}, a name that can move; building commit ${OPENPBS_RESOLVED}. Set the setting to that commit to pin the build."
  fi
  if [[ -z "${OPENPBS_RESOLVED}" ]] || ! git checkout --detach "${OPENPBS_RESOLVED}" \
      || [[ "$(git rev-parse HEAD)" != "${OPENPBS_RESOLVED}" ]]; then
    popd
    fail_bootstrap download-unverified "OpenPBS checkout of ${OPENPBS_COMMIT} (commit ${OPENPBS_RESOLVED:-not found}) failed"
  fi
  log_info "OpenPBS ${OPENPBS_COMMIT} resolves to commit ${OPENPBS_RESOLVED}"
  popd || exit

  # the marker is what check_openpbs_git_installed trusts, so only record a build that succeeded
  compile_and_install_openpbs "${OPENPBS_VERSION}" "${OPENPBS_WORK_DIR}/openpbs" || return 1
  echo -n "${OPENPBS_COMMIT}" > /opt/pbs/.idea_openpbs_commit
}

# Dependencies install only when OpenPBS does (a baked image already has both).
# Determine which installation method to use
# rhel10/rocky10 ship gcc 14, which rejects the v23.06.06 tarball with 24 incompatible-pointer-type
# errors in pbs_tclWrap.c; only the git branch carries the fix, so the release path is not offered.
{% set os_requiring_git = ['amazonlinux2023', 'rhel10', 'rocky10', 'ubuntu2204', 'ubuntu2404', 'ubuntu2604'] %}
{% if context.base_os in ('rhel8', 'rocky8') or (context.config.get_string('global-settings.package_config.openpbs.type') == 'release' and context.base_os not in os_requiring_git) %}
install_openpbs_release
{% else %}
install_openpbs_git
{% endif %}

{% endif %}
# End: Install OpenPBS
