# Begin: DCV Wayland owner login
# DCV's documented GNOME SSO needs system credentials; IDEA authenticates with broker tokens.
# https://docs.aws.amazon.com/dcv/latest/adminguide/setting-up-installing-linux-wayland-installation.html
if ! /usr/bin/python3 -c 'from gi.repository import Gio, GLib' >/dev/null 2>&1; then
{% if context.base_os == 'ubuntu2604' %}
  DEBIAN_FRONTEND=noninteractive apt install -y python3-gi || exit 1
{% else %}
  package_transaction dnf install -y python3-gobject-base || exit 1
{% endif %}
fi
install -d -m 755 /usr/local/libexec /usr/share/gdm/greeter/autostart || exit 1
cat > /usr/local/libexec/idea-dcv-login <<'PYCODE' || exit 1
{% include '_templates/linux/dcv_wayland_login_helper.jinja2' %}
PYCODE
chmod 755 /usr/local/libexec/idea-dcv-login || exit 1
cat > /usr/local/libexec/idea-dcv-lock-visible <<'PYCODE' || exit 1
{% include '_templates/linux/dcv_wayland_lock_helper.jinja2' %}
PYCODE
chmod 755 /usr/local/libexec/idea-dcv-lock-visible || exit 1
install -d -m 755 /etc/systemd/user/gnome-session.target.wants || exit 1
cat > /etc/systemd/user/idea-dcv-lock-visible.service <<'EOF_LOCK_SERVICE' || exit 1
[Unit]
Description=Keep the IDEA DCV owner's locked Wayland screen visible
After=gnome-session-initialized.target
PartOf=graphical-session.target
ConditionEnvironment=XDG_SESSION_TYPE=wayland
ConditionEnvironment=XDG_SESSION_CLASS=user
[Service]
ExecStart=/usr/local/libexec/idea-dcv-lock-visible
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
EOF_LOCK_SERVICE
ln -sfn ../idea-dcv-lock-visible.service /etc/systemd/user/gnome-session.target.wants/idea-dcv-lock-visible.service || exit 1
cat > /etc/pam.d/idea-dcv-login <<'EOF_PAM' || exit 1
auth requisite pam_exec.so expose_authtok quiet /usr/local/libexec/idea-dcv-login pam
# pam_exec does not implement setcred; permit it only after the requisite owner check.
auth required pam_permit.so
account required pam_nologin.so
{% if context.base_os == 'ubuntu2604' %}
account include common-account
{% else %}
account include system-auth
{% endif %}
password requisite pam_deny.so
session include gdm-password
EOF_PAM
cat > /usr/share/gdm/greeter/autostart/idea-dcv-login.desktop <<'EOF_DESKTOP' || exit 1
[Desktop Entry]
Type=Application
Name=IDEA DCV owner login
Exec=/usr/local/libexec/idea-dcv-login login
NoDisplay=true
X-GNOME-Autostart-Phase=Applications
EOF_DESKTOP
{% if context.base_os == 'ubuntu2604' %}
# GNOME's kiosk greeter does not run desktop autostart entries.
install -d -m 755 /etc/systemd/user/gnome-session@gnome-login.target.wants || exit 1
cat > /etc/systemd/user/idea-dcv-login.service <<'EOF_USER_SERVICE' || exit 1
[Unit]
Description=Sign in the IDEA DCV owner from the remote GDM greeter
After=org.gnome.Shell@gdm.service
PartOf=graphical-session.target
ConditionEnvironment=XDG_SESSION_CLASS=greeter
CollectMode=inactive-or-failed
[Service]
Type=oneshot
ExecStart=/usr/local/libexec/idea-dcv-login login
TimeoutStartSec=100
TimeoutStopSec=5
EOF_USER_SERVICE
ln -sfn ../idea-dcv-login.service /etc/systemd/user/gnome-session@gnome-login.target.wants/idea-dcv-login.service || exit 1
{% endif %}
cat > /etc/systemd/system/idea-dcv-login.service <<'EOF_SERVICE' || exit 1
[Unit]
Description=Authorize IDEA DCV owner login on the remote GDM greeter
After=dbus.service dcvserver.service
PartOf=dcvserver.service
[Service]
ExecStart=/usr/local/libexec/idea-dcv-login serve
Restart=on-failure
RuntimeDirectory=idea-dcv-login
RuntimeDirectoryMode=0755
StateDirectory=idea-dcv-login
StateDirectoryMode=0700
UMask=0077
[Install]
WantedBy=dcvserver.service
EOF_SERVICE
systemctl daemon-reload || exit 1
systemctl enable idea-dcv-login.service || exit 1
if systemctl is-active --quiet dcvserver.service; then
  systemctl restart idea-dcv-login.service || exit 1
fi
# End: DCV Wayland owner login
