# Begin: Install Prometheus Node Exporter
{% if context.base_os in ('amazonlinux2023', 'rhel8', 'rhel9', 'rhel10', 'rocky8', 'rocky9', 'rocky10', 'ubuntu2204', 'ubuntu2404', 'ubuntu2604') and context.is_prometheus_exporter_enabled('node_exporter') %}
PROMETHEUS_NODE_EXPORTER_AMD64_URL="{{ context.config.get_string('global-settings.package_config.prometheus.exporters.node_exporter.linux.x86_64', required=True) }}"
PROMETHEUS_NODE_EXPORTER_ARM64_URL="{{ context.config.get_string('global-settings.package_config.prometheus.exporters.node_exporter.linux.aarch64', required=True) }}"
# SHA-256 from each release's sha256sums.txt, for every archive a release of this product has
# named by default. Any other URL (a mirror, another version) needs its digest in
# global-settings.package_config.prometheus.exporters.node_exporter.linux.<x86_64|aarch64>_sha256, which takes precedence.
PROMETHEUS_NODE_EXPORTER_AMD64_SHA256='{{ context.config.get_string('global-settings.package_config.prometheus.exporters.node_exporter.linux.x86_64_sha256', default='') | default('', true) | string | replace("'", "'\\''") }}'
PROMETHEUS_NODE_EXPORTER_ARM64_SHA256='{{ context.config.get_string('global-settings.package_config.prometheus.exporters.node_exporter.linux.aarch64_sha256', default='') | default('', true) | string | replace("'", "'\\''") }}'
function node_exporter_sha256 () {
  case "${1}" in
    node_exporter-1.3.1.linux-amd64.tar.gz) echo -n 68f3802c2dd3980667e4ba65ea2e1fb03f4a4ba026cca375f15a0390ff850949 ;;
    node_exporter-1.3.1.linux-arm64.tar.gz) echo -n f19f35175f87d41545fa7d4657e834e3a37c1fe69f3bf56bc031a256117764e7 ;;
    node_exporter-1.9.1.linux-amd64.tar.gz) echo -n becb950ee80daa8ae7331d77966d94a611af79ad0d3307380907e0ec08f5b4e8 ;;
    node_exporter-1.9.1.linux-arm64.tar.gz) echo -n 848f139986f63232ced83babe3cad1679efdbb26c694737edc1f4fbd27b96203 ;;
    node_exporter-1.12.1.linux-amd64.tar.gz) echo -n b51d8a76aa2a9156a55d501aca6276fae09e262259a5e4e831d2c2222f084e63 ;;
    node_exporter-1.12.1.linux-arm64.tar.gz) echo -n ad35b605f9954b9f1ffddf5ba054bdc5a98d790b9eae5291e1eeb83f1ecbd0e7 ;;
  esac
}
function install_prometheus_node_exporter () {
  local MACHINE=$(uname -m)
  local DOWNLOAD_URL="" EXPECTED_SHA256 DIGEST_SETTING
  if [[ ${MACHINE} == "aarch64" ]]; then
    DOWNLOAD_URL="${PROMETHEUS_NODE_EXPORTER_ARM64_URL}"
    EXPECTED_SHA256="${PROMETHEUS_NODE_EXPORTER_ARM64_SHA256}"
    DIGEST_SETTING=global-settings.package_config.prometheus.exporters.node_exporter.linux.aarch64_sha256
  else
    DOWNLOAD_URL="${PROMETHEUS_NODE_EXPORTER_AMD64_URL}"
    EXPECTED_SHA256="${PROMETHEUS_NODE_EXPORTER_AMD64_SHA256}"
    DIGEST_SETTING=global-settings.package_config.prometheus.exporters.node_exporter.linux.x86_64_sha256
  fi
  local PACKAGE_ARCHIVE=$(basename ${DOWNLOAD_URL})
  local PACKAGE_NAME="${PACKAGE_ARCHIVE%.tar.gz*}"
  PROMETHEUS_DIR="/root/bootstrap/prometheus"
  mkdir -p ${PROMETHEUS_DIR}
  pushd ${PROMETHEUS_DIR}
  rm -f "${PACKAGE_ARCHIVE}"
  wget ${DOWNLOAD_URL}
  [[ -n "${EXPECTED_SHA256}" ]] || EXPECTED_SHA256=$(node_exporter_sha256 "${PACKAGE_ARCHIVE}")
  if [[ -z "${EXPECTED_SHA256}" ]]; then
    fail_bootstrap download-unverified "${DOWNLOAD_URL} has no pinned SHA-256: set ${DIGEST_SETTING} to the archive's SHA-256"
  fi
  sha256_matches "${PACKAGE_ARCHIVE}" "${EXPECTED_SHA256}" \
    || fail_bootstrap download-unverified "${PACKAGE_ARCHIVE} failed its checksum (expected from ${DIGEST_SETTING} or the release digests carried in this bundle)"
  # the archive's single top directory need not match the downloaded file's name (a mirror may
  # rename it): extract into a fresh directory, dropping that level, and require the binary
  rm -rf "${PACKAGE_NAME}.extracted" && mkdir "${PACKAGE_NAME}.extracted"
  if ! tar -xf "${PACKAGE_ARCHIVE}" --strip-components=1 -C "${PACKAGE_NAME}.extracted" \
      || [[ ! -f "${PACKAGE_NAME}.extracted/node_exporter" ]]; then
    fail_bootstrap download-failed "${PACKAGE_ARCHIVE} holds no node_exporter binary"
  fi
  cp "${PACKAGE_NAME}.extracted/node_exporter" /usr/local/bin/ || fail_bootstrap download-failed "node_exporter could not be installed"
}
function setup_prometheus_node_exporter_service () {
  echo "[Unit]
Description=Prometheus Node Exporter Service
After=network.target

[Service]
User=root
Group=root
Type=simple
ExecStart=/usr/local/bin/node_exporter

[Install]
WantedBy=multi-user.target
" > /etc/systemd/system/node-exporter.service
}
install_prometheus_node_exporter
setup_prometheus_node_exporter_service
systemctl enable node-exporter
systemctl start node-exporter
{% else %}
log_info "Prometheus Node Exporter is disabled"
{% endif %}
# End: Install Prometheus Node Exporter
