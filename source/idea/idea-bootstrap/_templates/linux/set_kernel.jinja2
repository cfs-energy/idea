# Begin: Kernel Version Management

# rhel10, rocky10, ubuntu2604 are absent: only the eVDI setup includes this template, none has eVDI support.
function fail_kernel_bootstrap() {
  local bootstrap_status="${1}"
  log_error "${2}"
  echo -n "no" > ${BOOTSTRAP_DIR}/reboot_required.txt
  local AWS
  local AWS_INSTANCE_ID
  AWS=$(command -v aws)
  AWS_INSTANCE_ID=$(instance_id)
  $AWS ec2 create-tags \
      --resources "${AWS_INSTANCE_ID}" \
      --region "{{ context.aws_region }}" \
      --tags "Key=idea:BootstrapStatus,Value=${bootstrap_status}" || log_warning "unable to tag ${AWS_INSTANCE_ID} with idea:BootstrapStatus=${bootstrap_status}"
  exit 1
}

{% if context.base_os in ('ubuntu2204', 'ubuntu2404', 'ubuntu2604') %}
# Bakes pin an ABI available from both Ubuntu and FSx for Lustre before package upgrades.
# Unbaked hosts keep the running-kernel check until their client install can target another ABI.
# Add the repository here because kernel management runs before client installation.
TARGET_KERNEL_ABI=$(uname -r)
{% if context.has_storage_provider('fsx_lustre') or context.has_storage_provider('fsx_cache') %}
# A baked image of this release already has the repository and passed the Lustre module
# check for this kernel in the bake; an apt-get update here cost its first boot the gate.
if [[ -z "${IDEA_MODULE_VERSION}" || "$(cat /var/lib/idea/baked-release 2>/dev/null)" != "${IDEA_MODULE_VERSION}" ]]; then
  . /etc/os-release
  wget -q -O - https://fsx-lustre-client-repo-public-keys.s3.amazonaws.com/fsx-ubuntu-public-key.asc | gpg --dearmor > /usr/share/keyrings/fsx-ubuntu-public-key.gpg
  echo "deb [signed-by=/usr/share/keyrings/fsx-ubuntu-public-key.gpg] https://fsx-lustre-client-repo.s3.amazonaws.com/ubuntu ${VERSION_CODENAME} main" > /etc/apt/sources.list.d/fsxlustreclientrepo.list
  apt_update || exit 1
{% if ubuntu_desktop_bake | default(false) %}  if [[ -n "${BAKE_STAGE:-}" ]]; then
    KERNEL_ARCH=$(dpkg --print-architecture)
    NEWEST_FSX_KERNEL_ABI=""
    SELECTED_KERNEL_ABI=""
    # Native-architecture policy entries exclude installed-only packages and other repositories.
    while read -r candidate_abi; do
      [[ "${candidate_abi}" == "${TARGET_KERNEL_ABI%%-*}"-* ]] || continue
      if ! apt-cache policy "lustre-client-modules-${candidate_abi}:${KERNEL_ARCH}" | grep -Fq "https://fsx-lustre-client-repo.s3.amazonaws.com/ubuntu ${VERSION_CODENAME}/main ${KERNEL_ARCH} Packages"; then
        continue
      fi
      [[ -n "${NEWEST_FSX_KERNEL_ABI}" ]] || NEWEST_FSX_KERNEL_ABI="${candidate_abi}"
      if [[ -n "$(apt-cache show "linux-image-${candidate_abi}:${KERNEL_ARCH}" 2>/dev/null)" ]]; then
        if [[ -z "${SELECTED_KERNEL_ABI}" || "${candidate_abi}" == "${TARGET_KERNEL_ABI}" ]]; then
          SELECTED_KERNEL_ABI="${candidate_abi}"
        fi
        [[ "${candidate_abi}" != "${TARGET_KERNEL_ABI}" ]] || break
      fi
    done < <(apt-cache pkgnames lustre-client-modules- | sed -n 's/^lustre-client-modules-\([0-9][0-9.]*-[0-9]*-aws\)$/\1/p' | sort -Vr)
    if [[ -z "${SELECTED_KERNEL_ABI}" ]]; then
      NEWEST_UBUNTU_KERNEL_ABI=""
      while read -r candidate_abi; do
        [[ "${candidate_abi}" == "${TARGET_KERNEL_ABI%%-*}"-* ]] || continue
        if [[ -n "$(apt-cache show "linux-image-${candidate_abi}:${KERNEL_ARCH}" 2>/dev/null)" ]]; then
          NEWEST_UBUNTU_KERNEL_ABI="${candidate_abi}"
          break
        fi
      done < <(apt-cache pkgnames linux-image- | sed -n 's/^linux-image-\([0-9][0-9.]*-[0-9]*-aws\)$/\1/p' | sort -Vr)
      fail_kernel_bootstrap lustre-module-missing "No available Ubuntu kernel has an FSx for Lustre module for ${KERNEL_ARCH}. Newest kernel supported by the FSx repository: ${NEWEST_FSX_KERNEL_ABI:-none}. Newest Ubuntu kernel ABI considered: ${NEWEST_UBUNTU_KERNEL_ABI:-none}."
    fi
    TARGET_KERNEL_ABI="${SELECTED_KERNEL_ABI}"
  elif [[ -z "$(apt-cache show "lustre-client-modules-${TARGET_KERNEL_ABI}" 2>/dev/null)" ]]; then
{% else %}  if [[ -z "$(apt-cache show "lustre-client-modules-${TARGET_KERNEL_ABI}" 2>/dev/null)" ]]; then
{% endif %}    fail_kernel_bootstrap lustre-module-missing "The FSx for Lustre repository has no lustre-client-modules-${TARGET_KERNEL_ABI} for the running kernel ${TARGET_KERNEL_ABI}."
  fi
fi
{% endif %}
TARGET_KERNEL_VERSION="${TARGET_KERNEL_ABI%-aws}*"
{% elif context.base_os in ('amazonlinux2023',) %}
# AL2023 builds lustre.ko into every kernel family (kernel, kernel6.12, kernel6.18): the kernel
# package itself provides kmod-lustre-client, and lustre-client needs nothing else. The host
# keeps the kernel its image boots; the only check is that it carries the module.
TARGET_KERNEL_ABI=$(uname -r)
if ! rpm -q --provides -f "/boot/vmlinuz-${TARGET_KERNEL_ABI}" 2>/dev/null | grep -q '^kmod-lustre-client'; then
  fail_kernel_bootstrap lustre-module-missing "The running kernel ${TARGET_KERNEL_ABI} does not provide kmod-lustre-client, the FSx for Lustre module."
fi
TARGET_KERNEL_VERSION="$(echo "${TARGET_KERNEL_ABI}" | cut -d. -f1-2)*"
{% elif context.base_os in ('rhel8', 'rocky8') %}
TARGET_KERNEL_VERSION="4.18.0-553*"
{% elif context.base_os in ('rhel9', 'rocky9') %}
{# 5.14.0-687 is the EL 9.8 kernel series; fsx_lustre_client.jinja2 carries the matching arm #}
TARGET_KERNEL_VERSION="5.14.0-687*"
{% elif context.base_os in ('rhel10', 'rocky10') %}
{# the series the image boots: fsx_lustre_client.jinja2 has a client for the 10.1 and 10.2 series,
   and pinning it keeps a package upgrade from moving the host to a kernel without one #}
TARGET_KERNEL_VERSION="$(uname -r | cut -d. -f1-3)*"
{% endif %}


{% if context.base_os not in ('ubuntu2204', 'ubuntu2404', 'ubuntu2604') or ubuntu_desktop_bake | default(false) %}function apply_kernel_holds() {
  local target_version="$TARGET_KERNEL_VERSION"
  local current_kernel=$(uname -r)

  log_info "Applying holds for current kernel ${current_kernel} to prevent further upgrades"

{% if context.base_os in ('ubuntu2204', 'ubuntu2404', 'ubuntu2604') %}
  # Hold the selected ABI, which may not be running until the builder's existing reboot.
  local package
  local kernel_packages=()
  local meta_packages=()
  for package in linux-image-${TARGET_KERNEL_ABI} linux-headers-${TARGET_KERNEL_ABI} linux-modules-${TARGET_KERNEL_ABI} linux-modules-extra-${TARGET_KERNEL_ABI}; do
    if dpkg -s "${package}" 2>/dev/null | grep -q '^Status: install ok installed$' || [[ -n "$(apt-cache show "${package}" 2>/dev/null)" ]]; then
      kernel_packages+=("${package}")
    fi
  done
  if [[ -n "${kernel_packages[*]}" ]]; then
    apt-mark hold "${kernel_packages[@]}" >/dev/null 2>&1 || \
        fail_kernel_bootstrap kernel-hold-failed "Unable to hold kernel ${TARGET_KERNEL_ABI}."
  fi
  for package in linux-aws linux-image-aws linux-headers-aws linux-tools-aws; do
    if dpkg -s "${package}" 2>/dev/null | grep -q '^Status: install ok installed$' || [[ -n "$(apt-cache show "${package}" 2>/dev/null)" ]]; then
      meta_packages+=("${package}")
    fi
  done
  if [[ -n "${meta_packages[*]}" ]]; then
    apt-mark hold "${meta_packages[@]}" >/dev/null 2>&1 || \
        log_warning "Unable to hold kernel metapackages."
  fi

{% elif context.base_os in ('amazonlinux2023',) %}
  # Install dnf-plugin-versionlock if not already present
  if ! dnf list installed dnf-plugin-versionlock >/dev/null 2>&1; then
    log_info "Installing dnf-plugin-versionlock for kernel version management"
    package_transaction dnf install -y dnf-plugin-versionlock >/dev/null 2>&1 || true
  fi
  # Lock the running kernel under its own package family (kernel, kernel6.12, ...)
  local kernel_package
  kernel_package=$(rpm -qf --queryformat '%{NAME}' "/boot/vmlinuz-${current_kernel}" 2>/dev/null) || kernel_package=kernel
  dnf versionlock ${kernel_package}-${current_kernel} ${kernel_package}-devel-${current_kernel} ${kernel_package}-headers-${current_kernel} >/dev/null 2>&1 || true

{% elif context.base_os in ('rhel8', 'rhel9', 'rhel10', 'rocky8', 'rocky9', 'rocky10') %}
  # Install dnf-plugin-versionlock if not already present
  if ! dnf list installed dnf-plugin-versionlock >/dev/null 2>&1; then
    log_info "Installing dnf-plugin-versionlock for kernel version management"
    package_transaction dnf install -y dnf-plugin-versionlock >/dev/null 2>&1 || true
  fi
  # Lock the specific current kernel version
  dnf versionlock kernel-${current_kernel} kernel-core-${current_kernel} kernel-devel-${current_kernel} kernel-headers-${current_kernel} >/dev/null 2>&1 || true
{% endif %}
}

function remove_unwanted_kernels() {
  local target_version="$TARGET_KERNEL_VERSION"
  local target_base="${target_version%\*}"  # Remove wildcard for pattern matching
  local current_kernel=$(uname -r)

  log_info "Removing all non-target kernel packages (keeping only ${target_version} series)"

{% if context.base_os in ('ubuntu2204', 'ubuntu2404', 'ubuntu2604') %}
  # Find all installed kernel packages that don't match our target series
  PACKAGES_TO_REMOVE=$(apt list --installed 2>/dev/null | grep -E "linux-(image|headers|modules|modules-extra)" | grep -v "${target_base}" | cut -d'/' -f1 | tr '\n' ' ')

  if [[ -n "$PACKAGES_TO_REMOVE" ]]; then
    log_info "Found non-target kernel packages to remove: $PACKAGES_TO_REMOVE"
    # Unhold packages before removal
    apt-mark unhold $PACKAGES_TO_REMOVE >/dev/null 2>&1 || true
    # Remove packages
    DEBIAN_FRONTEND=noninteractive apt purge -y $PACKAGES_TO_REMOVE 2>/dev/null || true
    # Clean up orphaned packages
    DEBIAN_FRONTEND=noninteractive apt autoremove -y 2>/dev/null || true
  else
    log_info "No non-target kernel packages found to remove"
  fi

{% elif context.base_os in ('amazonlinux2023',) %}
  # Nothing to remove: the target is the running kernel and kernel-headers here is the
  # userspace API package glibc-devel depends on, not a second kernel.
  log_info "Keeping the running kernel ${current_kernel}"

{% elif context.base_os in ('rhel8', 'rhel9', 'rhel10', 'rocky8', 'rocky9', 'rocky10') %}
  # Find all installed kernel packages that don't match our target version
  PACKAGES_TO_REMOVE=$(rpm -qa kernel kernel-core kernel-devel kernel-headers | grep -v "${target_base}" | tr '\n' ' ')

  if [[ -n "$PACKAGES_TO_REMOVE" ]]; then
    log_info "Found non-target kernel packages to remove: $PACKAGES_TO_REMOVE"
    dnf remove -y $PACKAGES_TO_REMOVE >/dev/null 2>&1 || true
  else
    log_info "No non-target kernel packages found to remove"
  fi
{% endif %}
}

function install_target_kernel() {
  local target_version="$TARGET_KERNEL_VERSION"
  local target_base="${target_version%\*}"  # Remove wildcard for some operations
  local current_kernel=$(uname -r)

  log_info "Installing target kernel ${target_version}"

{% if context.base_os in ('ubuntu2204', 'ubuntu2404', 'ubuntu2604') %}
  # Update package cache
  apt_update || exit 1

  # Exact ABI, not the linux-aws-<series> meta-package: the meta-package resolves to
  # whatever Ubuntu published last, which the FSx repo may not have modules for yet
  local kernel_packages=(linux-image-${TARGET_KERNEL_ABI} linux-modules-${TARGET_KERNEL_ABI})
  local package
  for package in linux-modules-extra-${TARGET_KERNEL_ABI} linux-headers-${TARGET_KERNEL_ABI}; do
    if [[ -n "$(apt-cache show "${package}" 2>/dev/null)" ]]; then
      kernel_packages+=("${package}")
    fi
  done
{% if context.has_storage_provider('fsx_lustre') or context.has_storage_provider('fsx_cache') %}  kernel_packages+=(lustre-client-modules-${TARGET_KERNEL_ABI})
{% endif %}  if DEBIAN_FRONTEND=noninteractive apt install -y "${kernel_packages[@]}" \
      -o DPkg::Lock::Timeout=300 --allow-change-held-packages; then
    log_info "Target kernel ${target_version} packages installed successfully"
  else
    log_error "Failed to install target kernel ${target_version} packages"
    return 1
  fi

{% elif context.base_os in ('rhel8', 'rocky8') %}
  # RHEL8/Rocky8 install latest in target series
  log_info "Installing latest kernel in ${target_version} series"
  if package_transaction dnf install -y kernel-${TARGET_KERNEL_VERSION} kernel-core-${TARGET_KERNEL_VERSION} kernel-devel-${TARGET_KERNEL_VERSION} kernel-headers-${TARGET_KERNEL_VERSION}; then
    log_info "Latest kernel in ${target_version} series installed successfully"
  else
    log_error "Failed to install latest kernel in ${target_version} series"
    return 1
  fi

{% elif context.base_os in ('rhel9', 'rhel10', 'rocky9', 'rocky10') %}
  # RHEL9/Rocky9 install latest in target series
  log_info "Installing latest kernel in ${target_version} series"
  if package_transaction dnf install -y kernel-${TARGET_KERNEL_VERSION} kernel-core-${TARGET_KERNEL_VERSION} kernel-devel-${TARGET_KERNEL_VERSION} kernel-headers-${TARGET_KERNEL_VERSION}; then
    log_info "Latest kernel in ${target_version} series installed successfully"
  else
    log_error "Failed to install latest kernel in ${target_version} series"
    return 1
  fi
{% endif %}
}

function set_kernel_version() {
{% if context.base_os in ('ubuntu2204', 'ubuntu2404', 'ubuntu2604') %}  [[ -n "${BAKE_STAGE:-}" ]] || return 0
{% endif %}  # Skip kernel management on captured images that already went through bootstrap
  if [[ -n "${IDEA_MODULE_VERSION}" && "$(cat /var/lib/idea/baked-release 2>/dev/null)" == "${IDEA_MODULE_VERSION}" ]]; then
    log_info "Baked release matches ${IDEA_MODULE_VERSION}; skipping kernel management"
    return 0
  fi

  local target_version="$TARGET_KERNEL_VERSION"
  local target_base="${target_version%\*}"  # Remove wildcard for pattern matching
  local current_kernel=$(uname -r)

  log_info "Current kernel: $current_kernel"
  log_info "Target kernel version: $target_version"

{% if context.base_os not in ('ubuntu2204', 'ubuntu2404', 'ubuntu2604') %}  # Check if we're already running the target kernel series
  if [[ "$current_kernel" == "${target_base}"[.-]* ]]; then
    log_info "Confirmed running target kernel series $target_base - pinning current version"
    apply_kernel_holds
    remove_unwanted_kernels
    return 0
  fi

{% endif %}  # A second pass on the old kernel means the boot loader did not honor the requested kernel.
{% if context.base_os in ('ubuntu2204', 'ubuntu2404', 'ubuntu2604') %}  if [[ "${current_kernel}" != "${TARGET_KERNEL_ABI}" ]] && [[ -f ${BOOTSTRAP_DIR}/reboot_history.log ]] && grep -Fq "kernel version change to ${target_version}" ${BOOTSTRAP_DIR}/reboot_history.log; then
{% else %}  if [[ -f ${BOOTSTRAP_DIR}/reboot_history.log ]] && grep -Fq "kernel version change to ${target_version}" ${BOOTSTRAP_DIR}/reboot_history.log; then
{% endif %}    fail_kernel_bootstrap kernel-boot-mismatch "Kernel ${target_version} was installed, but the host is still running ${current_kernel} after reboot."
  fi

  # Check if target kernel is already installed
  local kernel_installed=false
{% if context.base_os in ('ubuntu2204', 'ubuntu2404', 'ubuntu2604') %}
  if [[ "${current_kernel}" == "${TARGET_KERNEL_ABI}" ]]; then
    kernel_installed=true
  fi
{% elif context.base_os in ('rhel8', 'rocky8') %}
  # For RHEL8/Rocky8, check for any kernel in the target series
  if rpm -qa kernel | grep -q "${target_base}\."; then
    kernel_installed=true
  fi
{% elif context.base_os in ('rhel9', 'rhel10', 'rocky9', 'rocky10') %}
  # For RHEL9/Rocky9, check for any kernel in the target series
  if rpm -qa kernel | grep -q "${target_base}\."; then
    kernel_installed=true
  fi
{% endif %}

  # Install target kernel if not already installed
  if [[ "$kernel_installed" != "true" ]]; then
    log_info "Target kernel ${target_version} not installed, installing..."
    install_target_kernel || fail_kernel_bootstrap kernel-install-failed "Kernel ${target_version} could not be installed, so the host cannot boot it."
  else
    log_info "Target kernel ${target_version} already installed"
  fi

  # Apply holds to prevent unwanted upgrades
  apply_kernel_holds

{% if context.base_os in ('ubuntu2204', 'ubuntu2404', 'ubuntu2604') %}
  # Set default boot kernel
  if [[ -f /etc/default/grub ]]; then
    # Select by title because a positional entry changes as kernels are added or removed.
    # The exact ABI keeps the boot choice aligned with the installed Lustre module.
    sed -i "s/^GRUB_DEFAULT=.*/GRUB_DEFAULT=\"Advanced options for Ubuntu>Ubuntu, with Linux ${TARGET_KERNEL_ABI}\"/" /etc/default/grub
    update-grub || fail_kernel_bootstrap kernel-boot-mismatch "Unable to update GRUB for ${TARGET_KERNEL_ABI}."
    log_info "Updated GRUB to boot kernel ${target_version} by default"
  else
    fail_kernel_bootstrap kernel-boot-mismatch "Missing /etc/default/grub; cannot select ${TARGET_KERNEL_ABI}."
  fi
{% elif context.base_os in ('rhel8', 'rhel9', 'rhel10', 'rocky8', 'rocky9', 'rocky10') %}
  local target_kernel
  target_kernel=$(find /boot -maxdepth 1 -type f -name "vmlinuz-*${target_base}.*" -print | sort -V | tail -1)
  if [[ -n "${target_kernel}" ]]; then
    grubby --set-default "${target_kernel}" || log_warning "Unable to make ${target_kernel} the default boot kernel"
    log_info "Updated GRUB to boot ${target_kernel} by default"
  fi
{% endif %}

{% if context.base_os in ('ubuntu2204', 'ubuntu2404', 'ubuntu2604') %}  if [[ "${current_kernel}" != "${TARGET_KERNEL_ABI}" ]]; then
    [[ -f /boot/vmlinuz-${TARGET_KERNEL_ABI} ]] || fail_kernel_bootstrap kernel-install-failed "Kernel ${TARGET_KERNEL_ABI} not found in /boot after installation."
    set_reboot_required "Ubuntu kernel version change to ${target_version}"
  fi
  # Both builders own the continuation and reboot after their package upgrades.
{% else %}  # Only reboot if we're not already running the target kernel
  if [[ "$current_kernel" != "${target_base}"[.-]* ]]; then
    # Verify target kernel will be available on next boot
    if ls /boot/vmlinuz-${target_base}[.-]* >/dev/null 2>&1; then
      log_info "Kernel ${target_version} found in /boot, rebooting to activate"
{% if context.base_os in ('rhel8', 'rhel9', 'rhel10', 'rocky8', 'rocky9', 'rocky10') %}
      set_reboot_required "RHEL kernel version change to ${target_version}"
{% endif %}

      # Set up crontab to continue bootstrap after reboot
      (crontab -l 2>/dev/null | grep -v 'setup.sh' || true; echo "@reboot /bin/bash ${SCRIPT_DIR}/setup.sh crontab >> ${BOOTSTRAP_DIR}/logs/userdata_post_reboot.log 2>&1") | crontab -

      check_reboot_loop "Kernel installation reboot"
      reboot_after_cloud_init
      exit 0
    else
      log_error "Kernel ${target_version} not found in /boot after installation"
      return 1
    fi
  else
    log_info "Already running target kernel ${target_version} - pinning current version"
    apply_kernel_holds
    remove_unwanted_kernels
  fi
{% endif %}}

# Execute kernel version management for all supported distributions
{% if context.base_os in ('ubuntu2204', 'ubuntu2404', 'ubuntu2604', 'amazonlinux2023', 'rhel8', 'rhel9', 'rhel10', 'rocky8', 'rocky9', 'rocky10') %}
set_kernel_version
{% endif %}
{% else %}
# Hosts that are not baking keep the kernel their image boots and hold it as 26.10.4 did: the
# running kernel's packages, and the linux-aws metapackages when they point at the running series
# (removed otherwise), so an apt upgrade cannot move a desktop to a kernel without a Lustre module.
function apply_kernel_holds() {
  local target_version="$TARGET_KERNEL_VERSION"
  local current_kernel=$(uname -r)

  log_info "Applying holds for current kernel ${current_kernel} to prevent further upgrades"

  # Hold the specific kernel version we're currently running
  apt-mark hold linux-image-${current_kernel} linux-headers-${current_kernel} linux-modules-${current_kernel} linux-modules-extra-${current_kernel} >/dev/null 2>&1 || true

  # Check if meta-packages point to our target series or need to be removed
  local target_base="${target_version%\*}"
  local meta_kernel_version=""

  # Check what kernel version the meta-packages currently point to
  if dpkg -l linux-aws 2>/dev/null | grep -q "^ii"; then
    meta_kernel_version=$(apt-cache depends linux-aws | grep -E "Depends: linux-image-aws" | head -1 | cut -d'-' -f4 | cut -d'.' -f1-2 2>/dev/null || echo "")
  fi

  if [[ -n "$meta_kernel_version" ]] && [[ "$meta_kernel_version" == "${target_base%.*}" ]]; then
    # Meta-packages point to our target series, hold them
    log_info "Meta-packages point to target series ${target_base} - holding them"
    apt-mark hold linux-aws linux-image-aws linux-headers-aws linux-tools-aws >/dev/null 2>&1 || true
  else
    # Meta-packages point to wrong series or don't exist, remove them
    log_info "Meta-packages point to wrong kernel series or don't exist - removing them"
    DEBIAN_FRONTEND=noninteractive apt remove -y linux-aws linux-image-aws linux-headers-aws linux-tools-aws >/dev/null 2>&1 || true
  fi
}

function remove_unwanted_kernels() {
  local target_version="$TARGET_KERNEL_VERSION"
  local target_base="${target_version%\*}"  # Remove wildcard for pattern matching
  local current_kernel=$(uname -r)

  log_info "Removing all non-target kernel packages (keeping only ${target_version} series)"

  # Find all installed kernel packages that don't match our target series
  PACKAGES_TO_REMOVE=$(apt list --installed 2>/dev/null | grep -E "linux-(image|headers|modules|modules-extra)" | grep -v "${target_base}" | cut -d'/' -f1 | tr '\n' ' ')

  if [[ -n "$PACKAGES_TO_REMOVE" ]]; then
    log_info "Found non-target kernel packages to remove: $PACKAGES_TO_REMOVE"
    # Unhold packages before removal
    apt-mark unhold $PACKAGES_TO_REMOVE >/dev/null 2>&1 || true
    # Remove packages
    DEBIAN_FRONTEND=noninteractive apt purge -y $PACKAGES_TO_REMOVE 2>/dev/null || true
    # Clean up orphaned packages
    DEBIAN_FRONTEND=noninteractive apt autoremove -y 2>/dev/null || true
  else
    log_info "No non-target kernel packages found to remove"
  fi
}

function set_kernel_version() {
  # Skip kernel management on captured images that already went through bootstrap
  if [[ -n "${IDEA_MODULE_VERSION}" && "$(cat /var/lib/idea/baked-release 2>/dev/null)" == "${IDEA_MODULE_VERSION}" ]]; then
    log_info "Baked release matches ${IDEA_MODULE_VERSION}; skipping kernel management"
    return 0
  fi

  log_info "Keeping the running kernel $(uname -r)"
  apply_kernel_holds
  remove_unwanted_kernels
}

set_kernel_version
{% endif %}# End: Kernel Version Management
