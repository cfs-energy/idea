# Begin: motd update
{% if context.base_os in ('amazonlinux2023', 'rhel8', 'rhel9', 'rhel10', 'rocky8', 'rocky9', 'rocky10', 'ubuntu2204', 'ubuntu2404', 'ubuntu2604') %}
# a quoted here-document: the messages (queue, job group, project names) are data
cat > /etc/motd <<'IDEA_MOTD'

     ________  _________
    /  _/ __ \/ ____/   |
    / // / / / __/ / /| |
  _/ // /_/ / /___/ ___ |
 /___/_____/_____/_/  |_|
{% for message in messages %}
{{ message }}
{% endfor %}
> source /etc/environment to load IDEA paths

IDEA_MOTD
{% endif %}
# End: motd update
