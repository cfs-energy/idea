# Begin: Install jq
{% if context.base_os in ('amazonlinux2023', 'rhel8', 'rhel9', 'rhel10', 'rocky8', 'rocky9', 'rocky10') %}
which jq > /dev/null 2>&1
if [[ "$?" != "0" ]]; then
  log_info "installing jq"
  yum install -y jq
fi
{% elif context.base_os in ('ubuntu2204', 'ubuntu2404', 'ubuntu2604') %}
which jq > /dev/null 2>&1
if [[ "$?" != "0" ]]; then
  log_info "installing jq"
  apt install -y jq
fi
{% endif %}

# End: Install jq
