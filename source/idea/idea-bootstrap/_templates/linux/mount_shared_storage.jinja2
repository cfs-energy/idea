# Begin: Mount Shared Storage
{# values from cluster settings are data: single-quoted for the shell, embedded quotes escaped #}
{% if context.base_os in ('amazonlinux2023', 'rhel8', 'rhel9', 'rhel10', 'rocky8', 'rocky9', 'rocky10', 'ubuntu2204', 'ubuntu2404', 'ubuntu2604') %}
  {% if context.has_storage_provider('fsx_lustre') or context.has_storage_provider('fsx_cache') %}
    {% include '_templates/linux/fsx_lustre_client.jinja2' %}
    {% if not (ubuntu_desktop_bake | default(false)) %}
    REBOOT_REQUIRED=$(cat /root/bootstrap/reboot_required.txt)
    if [[ "${REBOOT_REQUIRED}" == "yes" ]]; then
      (crontab -l 2>/dev/null || true; echo "@reboot /bin/bash ${SCRIPT_DIR}/setup.sh crontab >> ${BOOTSTRAP_DIR}/logs/userdata_post_reboot.log 2>&1") | crontab -
      check_reboot_loop "FSx storage mount reboot"
      reboot_after_cloud_init
      exit 0
    fi
    {% endif %}
  {% endif %}
  {% include '_templates/linux/shared_mount_dirs.jinja2' %}
  function mount_shared_storage () {
    {% for name, storage in context.config.get_config('shared-storage').items() %}
      {% if context.eval_shared_storage_scope(shared_storage=storage) %}
        {% if storage['provider'] == 'efs' %}
        echo '# Using Provider' '{{ storage['provider'] | default('', true) | string | replace("'", "'\\''") }}' for '{{ storage['mount_dir'] | default('', true) | string | replace("'", "'\\''") }}' using options '{{ storage['mount_options'] | default('', true) | string | replace("'", "'\\''") }}'
        mkdir -p '{{ storage['mount_dir'] | default('', true) | string | replace("'", "'\\''") }}'
        add_efs_to_fstab '{{ storage['efs']['dns'] | default('', true) | string | replace("'", "'\\''") }}' \
                         '{{ storage['mount_dir'] | default('', true) | string | replace("'", "'\\''") }}' \
                         '{{ storage['mount_options'] | default('', true) | string | replace("'", "'\\''") }}'
        {% elif storage['provider'] in ('fsx_cache', 'fsx_lustre') %}
        # Check if lustre module is loaded
        if ! grep -q lustre /proc/filesystems; then
          echo "Lustre filesystem not detected in /proc/filesystems"

          # Check if lustre module is installed
          if modinfo lustre &>/dev/null; then
            echo "Lustre module is installed but not loaded, attempting to load..."
            modprobe lustre || echo "Failed to load lustre module"
          else
            echo "Lustre module is not installed. Please install lustre client package."
          fi
        fi

        # Check if lustre module is now loaded
        if grep -q lustre /proc/filesystems; then
          mkdir -p '{{ storage['mount_dir'] | default('', true) | string | replace("'", "'\\''") }}'
          add_fsx_lustre_to_fstab '{{ storage[storage['provider']]['dns'] | default('', true) | string | replace("'", "'\\''") }}' \
                                  '{{ storage['mount_dir'] | default('', true) | string | replace("'", "'\\''") }}' \
                                  '{{ storage['mount_options'] | default('', true) | string | replace("'", "'\\''") }}' \
                                  '{{ storage[storage['provider']]['mount_name'] | default('', true) | string | replace("'", "'\\''") }}'
        else
          echo 'Lustre filesystem not available. Skipping mount for' '{{ storage['mount_dir'] | default('', true) | string | replace("'", "'\\''") }}'
        fi
        {% elif storage['provider'] == 'fsx_netapp_ontap' and storage['fsx_netapp_ontap']['volume']['security_style'] %}
        mkdir -p '{{ storage['mount_dir'] | default('', true) | string | replace("'", "'\\''") }}'
        add_fsx_netapp_ontap_to_fstab '{{ storage['fsx_netapp_ontap']['svm']['nfs_dns'] | default('', true) | string | replace("'", "'\\''") }}' \
                                      '{{ storage['mount_dir'] | default('', true) | string | replace("'", "'\\''") }}' \
                                      '{{ storage['mount_options'] | default('', true) | string | replace("'", "'\\''") }}' \
                                      '{{ storage['fsx_netapp_ontap']['volume']['volume_path'] | default('', true) | string | replace("'", "'\\''") }}'
        {% elif storage['provider'] == 'fsx_openzfs' %}
        mkdir -p '{{ storage['mount_dir'] | default('', true) | string | replace("'", "'\\''") }}'
        add_fsx_openzfs_to_fstab '{{ storage['fsx_openzfs']['dns'] | default('', true) | string | replace("'", "'\\''") }}' \
                                 '{{ storage['mount_dir'] | default('', true) | string | replace("'", "'\\''") }}' \
                                 '{{ storage['mount_options'] | default('', true) | string | replace("'", "'\\''") }}' \
                                 '{{ storage['fsx_openzfs']['volume_path'] | default('', true) | string | replace("'", "'\\''") }}'
        {% endif %}
      {% endif %}
    {% endfor %}

    local FS_MOUNT_ATTEMPT=1
    local FS_MOUNT_MAX_ATTEMPTS=5
    {% if (ubuntu_desktop_bake | default(false)) and (context.has_storage_provider('fsx_lustre') or context.has_storage_provider('fsx_cache')) %}
    local MOUNT_TYPES=()
    if ! modinfo lustre >/dev/null 2>&1; then
      log_info "Deferring Lustre mounts until the builder boots the selected kernel"
      MOUNT_TYPES=(-t nolustre)
    fi
    while [[ ${FS_MOUNT_ATTEMPT} -lt ${FS_MOUNT_MAX_ATTEMPTS} ]] && ! mount_shared_filesystems "${MOUNT_TYPES[@]}"; do
    {% else %}
    while [[ ${FS_MOUNT_ATTEMPT} -lt ${FS_MOUNT_MAX_ATTEMPTS} ]] && ! mount_shared_filesystems; do
    {% endif %}
      local SLEEP_TIME=$(( RANDOM % 33 + 8 ))  # Minimum of 8 seconds sleep
      log_info "(${FS_MOUNT_ATTEMPT} of ${FS_MOUNT_MAX_ATTEMPTS}) retrying in ${SLEEP_TIME} seconds ..."
      sleep "${SLEEP_TIME}"
      FS_MOUNT_ATTEMPT=$(( FS_MOUNT_ATTEMPT + 1 ))
    done
    # the last attempt is a plain call: a bake records it, the caller sees its status
    {% if (ubuntu_desktop_bake | default(false)) and (context.has_storage_provider('fsx_lustre') or context.has_storage_provider('fsx_cache')) %}
    mount_shared_filesystems "${MOUNT_TYPES[@]}"
    {% else %}
    mount_shared_filesystems
    {% endif %}
  }
  # a plain call, so a bake records the failure by name; a host stops rather than run without its storage
  mount_shared_storage
  # shellcheck disable=SC2181
  if [[ $? -ne 0 ]]; then
    # its own status, so the scheduler and the desktop controller can tell a storage problem
    # from an image one
    fail_bootstrap shared-storage-unavailable "Shared storage did not mount after 5 attempts: ${SHARED_STORAGE_NOT_MOUNTED:-a configured file system}. Check that the file system exists and that this host's subnet and security groups reach it."
  fi
  {% if context.has_storage_provider('fsx_lustre') or context.has_storage_provider('fsx_cache') %}
    # Lustre client tuning for some adjustments takes place _after_ the client mounts have taken place
    {% include '_templates/linux/fsx_lustre_client_tuning_postmount.jinja2' %}
  {% endif %}
{% endif %}
# End: Mount Shared Storage
