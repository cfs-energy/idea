# Begin: NFS Utils and dependency items

{% if context.base_os in ('rhel8', 'rhel9', 'rhel10', 'rocky8', 'rocky9', 'rocky10') %}
if [[ -z "$(rpm -qa nfs-utils)" ]]; then
  log_info "# installing nfs-utils"
  package_transaction yum install -y nfs-utils
fi
{% elif context.base_os in ('ubuntu2204', 'ubuntu2404', 'ubuntu2604') %}
if [[ -z "$(dpkg -l nfs-common | grep ^ii)" ]]; then
  log_info "# installing nfs-common"
  apt_update || log_warning "APT index refresh failed; continuing with the existing package index."
  apt install -y nfs-common
fi
{% endif %}

{% include '_templates/linux/efs_mount_helper.jinja2' %}

# End: NFS Utils
