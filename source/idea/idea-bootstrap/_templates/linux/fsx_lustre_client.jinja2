# Begin: FSx Lustre Client

# Kernel management is handled separately by set_kernel.jinja2.

# Hosts that mount Lustre (in scope here, job scratch, image bakes) cannot work without it.
# Every other host installs the client only because the cluster has Lustre: it logs and goes on.
LUSTRE_REQUIRED=no
{% if lustre_required | default(false) or compute_image_bake | default(false) %}
LUSTRE_REQUIRED=yes
{% endif %}
{% for name, storage in context.config.get_config('shared-storage').items() %}
{% if storage['provider'] in ('fsx_lustre', 'fsx_cache') and context.eval_shared_storage_scope(shared_storage=storage) %}
LUSTRE_REQUIRED=yes
{% endif %}
{% endfor %}

# A reboot cannot install a package or add a module that does not exist: a host that needs
# Lustre stops with the reason instead of rebooting until check_reboot_loop gives up.
function fail_lustre_client () {
  local reason="${1}"
  local message="${2} Lustre filesystems cannot be mounted on this node (reason code: ${1})."
  log_error "${message}"
  [[ "${LUSTRE_REQUIRED}" == yes ]] || return 0
  echo -n "no" > ${BOOTSTRAP_DIR}/reboot_required.txt
  # desktops: set_kernel tags idea:BootstrapStatus so the controller releases the host
  ! declare -F fail_kernel_bootstrap >/dev/null || fail_kernel_bootstrap "${reason}" "${message}"
{% if compute_image_bake | default(false) %}
  # compute bakes have no ERR trap: record the reason and tag the builder failed now
  echo "lustre: ${message}" >> /var/lib/idea/bake-failed
  /bin/bash "${SCRIPT_DIR}/image_checks.sh"
  exit 1
{% else %}
  # as for EFA: a compute node that exits here never joins, and the scheduler holds its job
  exit_fail "Aborting bootstrap, this node will not join the cluster."
{% endif %}
}

# EL: only a successful install reboots, so the client module loads
function lustre_client_installed () {
  if [[ "${1}" -eq 0 ]]; then
    set_reboot_required "FSx for Lustre client installed"
  else
    fail_lustre_client lustre-client-install-failed "Unable to install the FSx for Lustre client for kernel $(uname -r)."
  fi
}
{% if context.base_os in ('rhel8', 'rocky8', 'rhel9', 'rocky9', 'rhel10', 'rocky10') %}

# No client build for the running kernel. Reboot only if the default boot kernel differs
# (the kernel update above just installed one); otherwise no reboot can change the answer.
function lustre_kernel_unsupported () {
  local default_kernel
  default_kernel=$(grubby --default-kernel 2>/dev/null)
  if [[ -n "${default_kernel}" && "${default_kernel}" != "/boot/vmlinuz-$(uname -r)" ]]; then
    log_info "Booting ${default_kernel##*/vmlinuz-} to retry the FSx for Lustre client install"
    set_reboot_required "Kernel installed for FSx for Lustre client"
  else
    fail_lustre_client lustre-module-missing "${1}"
  fi
}
{% endif %}

