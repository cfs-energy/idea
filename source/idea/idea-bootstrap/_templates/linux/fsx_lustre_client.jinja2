{% if context.base_os == 'ubuntu2604' %}
{# The FSx for Lustre ubuntu repo publishes no 'resolute' suite and no lustre-client-modules
   for the 7.0.0-*-aws ABI, so adding ubuntu2604 below would write a permanently 404ing apt
   source. Re-add it only once that suite carries modules for the resolute linux-aws ABI. #}
log_error "FSx for Lustre client is not available for Ubuntu 26.04: the FSx client repo publishes no 'resolute' suite and no modules for the 7.0 kernel. Lustre filesystems will NOT be mounted on this node."
{% endif %}
{% if context.base_os in ('ubuntu2204', 'ubuntu2404') %}
  if [[ -z "$(dpkg -l lustre-client-utils | grep ^ii)" ]]; then
    # Kernel version is now managed by set_kernel.jinja2 - proceed with installation
    wget -O - https://fsx-lustre-client-repo-public-keys.s3.amazonaws.com/fsx-ubuntu-public-key.asc | gpg --dearmor | sudo tee /usr/share/keyrings/fsx-ubuntu-public-key.gpg >/dev/null
    bash -c 'echo "deb [signed-by=/usr/share/keyrings/fsx-ubuntu-public-key.gpg] https://fsx-lustre-client-repo.s3.amazonaws.com/ubuntu $(lsb_release -cs) main" > /etc/apt/sources.list.d/fsxlustreclientrepo.list && apt update'

    if DEBIAN_FRONTEND=noninteractive apt install -y lustre-client-modules-aws; then
      set_reboot_required "FSx for Lustre client installed"
      log_info "FSx Lustre client installed successfully"
    else
      # no top-level `return`: this template is included at script scope, where
      # bash rejects `return` with an error and continues anyway
      log_error "Failed to install FSx Lustre client - dpkg may be interrupted. Lustre filesystems will NOT be mounted on this node."
    fi
  else
    log_info "Lustre Client Already Installed"
  fi
{% endif %}
# Performance tuning
if [[ ! -f /etc/modprobe.d/lustre.conf ]] || [[ -z "$(grep ksocklnd /etc/modprobe.d/lustre.conf)" ]]; then
{% include '_templates/linux/fsx_lustre_client_tuning_prereboot.jinja2' %}
fi

