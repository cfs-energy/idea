{# ubuntu2604: the FSx repo's 'resolute' suite carries modules for one 7.0.0-*-aws ABI at a time;
   bakes pick that kernel in set_kernel.jinja2 and unbaked hosts need their image to boot it #}
{% if context.base_os in ('ubuntu2204', 'ubuntu2404', 'ubuntu2604') %}
{% if ubuntu_desktop_bake | default(false) %}
  if [[ "${BAKE_STAGE}" == setup ]]; then
    # setup selected the ABI before this include; the builder owns the reboot.
    DEBIAN_FRONTEND=noninteractive apt install -y lustre-client-utils "lustre-client-modules-${TARGET_KERNEL_ABI}" || \
      fail_kernel_bootstrap lustre-client-install-failed "Unable to install FSx for Lustre client for ${TARGET_KERNEL_ABI}."
    set_reboot_required "FSx for Lustre client installed"
  fi
{% else %}
  if [[ -z "$(dpkg -l lustre-client-utils | grep ^ii)" ]]; then
    # Kernel version is now managed by set_kernel.jinja2 - proceed with installation
    wget -O - https://fsx-lustre-client-repo-public-keys.s3.amazonaws.com/fsx-ubuntu-public-key.asc | gpg --dearmor | sudo tee /usr/share/keyrings/fsx-ubuntu-public-key.gpg >/dev/null
    bash -c 'echo "deb [signed-by=/usr/share/keyrings/fsx-ubuntu-public-key.gpg] https://fsx-lustre-client-repo.s3.amazonaws.com/ubuntu $(lsb_release -cs) main" > /etc/apt/sources.list.d/fsxlustreclientrepo.list && apt update'

    # Request the running kernel's module package directly so the metapackage cannot
    # move to another ABI before the host installs the client.
    if DEBIAN_FRONTEND=noninteractive apt install -y lustre-client-utils lustre-client-modules-$(uname -r); then
      set_reboot_required "FSx for Lustre client installed"
      log_info "FSx Lustre client installed successfully"
    else
      # no top-level `return`: this template is included at script scope, where
      # bash rejects `return` with an error and continues anyway
      fail_lustre_client lustre-client-install-failed "Unable to install the FSx for Lustre client for kernel $(uname -r) - dpkg may be interrupted."
    fi
  elif modinfo -n lustre >/dev/null 2>&1; then
    log_info "Lustre Client Already Installed"
  else
    fail_lustre_client lustre-module-missing "FSx for Lustre client is installed but has no module for kernel $(uname -r)."
  fi
{% endif %}
{% endif %}
