# Begin: Tag Network Interface
function tag_network_interface () {
  local TAGS='{{ context.utils.to_json(network_interface_tags + context.get_custom_aws_tags()) }}'
  local AWS=$(command -v aws)
  local AWS_INSTANCE_ID=$(instance_id)
  local INTERFACES=$($AWS ec2 describe-network-interfaces \
                             --filters "Name=attachment.instance-id,Values=${AWS_INSTANCE_ID}" \
                             --region "{{ context.aws_region }}" \
                             --query "NetworkInterfaces[*].[NetworkInterfaceId]" \
                             --out text)
  # ENI_IDS is intentionally unquoted below: a node with multi-rail EFA has one ENI per network
  # card and --resources takes them as separate values. Quoting sends them as a single malformed id.
  local ENI_IDS=$(echo "${INTERFACES}" | tr "\n" " ")
  local MAX_RETRIES=5
  local RETRY_COUNT=0
  local TAG_STATUS

  $AWS ec2 create-tags --resources ${ENI_IDS} \
      --region "{{ context.aws_region }}" \
      --tags "${TAGS}"
  # Read the status into a variable straight away: any declaration or assignment in between
  # would replace $? with its own status and the loop below would never run.
  TAG_STATUS=$?

  while [[ ${TAG_STATUS} -ne 0 ]] && [[ ${RETRY_COUNT} -lt ${MAX_RETRIES} ]]
  do
    local SLEEP_TIME=$(( RANDOM % 33 + 8 ))   # Sleep for 8-40 seconds
    log_info "(${RETRY_COUNT}/${MAX_RETRIES}) ec2 tag failed due to EC2 API error, retrying in ${SLEEP_TIME} seconds ..."
    sleep ${SLEEP_TIME}
    ((RETRY_COUNT++))
    $AWS ec2 create-tags --resources ${ENI_IDS} \
          --region "{{ context.aws_region }}" \
          --tags "${TAGS}"
    TAG_STATUS=$?
  done

  # untagged interfaces must not fail the boot: warn so the gap is visible in the bootstrap log.
  if [[ ${TAG_STATUS} -ne 0 ]]; then
    log_warning "ec2 tag failed after ${MAX_RETRIES} retries, network interfaces are left untagged"
  fi
}
tag_network_interface
# End: Tag Network Interface
