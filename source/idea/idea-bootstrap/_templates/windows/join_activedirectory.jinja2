{% from '_templates/windows/ps_text.jinja2' import ps_text %}
# Begin: Join ActiveDirectory (PowerShell/Windows)

# Add the AmazonDynamoDB .NET framework class.
Add-Type -Path (${env:ProgramFiles(x86)} + "\AWS SDK for .NET\bin\Net45\AWSSDK.DynamoDBv2.dll")

$AWS_REGION = '{{ ps_text(context.config.get_string('cluster.aws.region', required=True)) }}'
# a random GUID (122 random bits): the nonce keys this host's one-time join password
$AD_AUTHORIZATION_NONCE = [guid]::NewGuid().ToString('N')
$AD_AUTHORIZATION_INSTANCE_ID = $( Get-EC2InstanceMetadata -Category InstanceId )
$AD_AUTOMATION_SQS_QUEUE_URL = '{{ ps_text(context.config.get_string('directoryservice.ad_automation.sqs_queue_url', required=True)) }}'
$AD_AUTOMATION_DDB_TABLE_NAME = '{{ ps_text(context.config.get_string('cluster.cluster_name', required=True)) }}.ad-automation'
$AD_DOMAIN_NAME = '{{ ps_text(context.config.get_string('directoryservice.name', required=True)) }}'
$AD_SHORT_NAME = '{{ ps_text(context.config.get_string('directoryservice.ad_short_name', required=True)) }}'

# Various timers / settings controlling AD Join process
# These configuration settings impact the AD Join process after the eVDI client is authorized to join Active Directory
$AD_JOIN_MAX_SLEEP = "{{ context.config.get_int('directoryservice.ad_automation.ad_join_max_sleep', default=31) }}"
$AD_JOIN_RETRY_COUNT = "{{ context.config.get_int('directoryservice.ad_automation.ad_join_retry_count', default=10) }}"

function Send-ADAutomationSQSMessage
{
  <#
      .SYNOPSIS
          Send the authorization payload to IDEA AD Automation SQS Queue
  #>
  [OutputType([Boolean])]
  [CmdletBinding()]
  # the name the computer account is created with: Configure passes the IDEA hostname, so
  # the join renames (Rename-Computer, then Add-Computer JoinWithNewName); one restart applies both
  Param([String] $Hostname = $env:COMPUTERNAME)

  $payload = @{ header = @{ namespace = 'ADAutomation.PresetComputer' }; payload = @{ nonce = $AD_AUTHORIZATION_NONCE; instance_id = $AD_AUTHORIZATION_INSTANCE_ID; hostname = $Hostname } } | ConvertTo-Json -Compress
  # todo - support vpc endpoint
  # the nonce keys this host's one-time join password: it is never logged
  Write-ToLog -Message ("[Join AD] Sending to AD Automation: $AD_AUTOMATION_SQS_QUEUE_URL /  InstanceID: $AD_AUTHORIZATION_INSTANCE_ID ...")

  # a failed send is retried by Start-ADAutomationAuthorization: it is reported, never thrown
  try {
    $sqs_output = Send-SQSMessage -QueueUrl $AD_AUTOMATION_SQS_QUEUE_URL `
                    -MessageBody $payload `
                    -MessageGroupId $AD_AUTHORIZATION_INSTANCE_ID `
                    -MessageDeduplicationId "ADAutomation.PresetComputer.$AD_AUTHORIZATION_INSTANCE_ID.$AD_AUTHORIZATION_NONCE" `
                    -Region $AWS_REGION -ErrorAction Stop | Out-String
    $exit_status = $true
  } catch {
    Write-ToLog -Message "[Join AD] sending the authorization request failed: $($_.Exception.Message)" -Level 'Warn'
    return $false
  }
  Write-ToLog -Message ("[Join AD] SQS Output: $sqs_output")
  $exit_status
}

function Start-ADAutomationAuthorization
{
  <#
      .SYNOPSIS
          Invoke Send-ADAutomationSQSMessage until message is posted successfully.
  #>
  [CmdletBinding()]
  Param([String] $Hostname = $env:COMPUTERNAME)
  $attemptCount = 0
  $maxAttempts = 5
  $success = Send-ADAutomationSQSMessage -Hostname $Hostname
  while (($success -ne $true) -and ($attemptCount -le $maxAttempts))
  {
    $sleepTime = $( Get-Random -Minimum 3 -Maximum 10 )
    Write-ToLog -Message "[Join AD] ($attemptCount of $maxAttempts) failed to request authorization to join AD, retrying in $sleepTime seconds ..."
    Start-Sleep -Seconds $sleepTime
    $attemptCount++
    $success = Send-ADAutomationSQSMessage -Hostname $Hostname
  }
}

function Get-ADAutomationAuthorizationEntry
{
  <#
      .SYNOPSIS
          Retrieve the AD Automation Authorization entry from IDEA AD Automation DynamoDB Table
  #>
  [OutputType([Hashtable])]
  [OutputType([System.Void])]
  [CmdletBinding()]

  $key = @{
    instance_id = "$AD_AUTHORIZATION_INSTANCE_ID"
    nonce = "$AD_AUTHORIZATION_NONCE"
  } | ConvertTo-DDBItem

  # a failed read is polled again until the deadline: it is reported, never thrown
  try {
    $response = Get-DDBItem -TableName $AD_AUTOMATION_DDB_TABLE_NAME -Key $key -Select * -ErrorAction Stop
  } catch {
    Write-ToLog -Message "[Join AD] reading the authorization entry failed: $($_.Exception.Message)" -Level 'Warn'
    return
  }

  if ($response.IsItemSet -eq $false)
  {
    return
  }

  if ($response.Item.status.S -eq "success")
  {
    @{
        status = $($response.Item.status.S);
        domain_controller = $($response.Item.domain_controller.S);
        otp = $($response.Item.otp.S);
        hostname = $($response.Item.hostname.S);
        ou = $($response.Item.ou.S);
    }
  }
  else
  {
    @{
        status = $($response.Item.status.S);
        error_code = $($response.Item.error_code.S);
        message = $($response.Item.message.S)
    }
  }
}

function Start-ADAutomationWaitForAuthorizationAndJoin
{
  <#
      .SYNOPSIS
          Wait for cluster manager to create a computer account. Keep polling IDEA AD Automation DDB table for authorization entry.
          If status = 'success', Join AD using the Domain Controller and One-Time Password available in response.
          If status = 'fail', log error code and message
  #>
  [CmdletBinding()]

  # Configure reports the desktop ready only after this is set by a join that succeeded
  $global:IdeaDomainJoined = $false

  # the automation agent usually answers within seconds: poll every 3 s, within the same
  # overall wait the retry settings allowed (a fixed 30 s sleep cost every desktop ~30 s)
  $authorizationDeadline = (Get-Date).AddSeconds([int]$AD_JOIN_RETRY_COUNT * [int]$AD_JOIN_MAX_SLEEP)
  $attemptCount = 0
  $authorizationEntry = Get-ADAutomationAuthorizationEntry
  while (($authorizationEntry -eq $null) -and ((Get-Date) -lt $authorizationDeadline))
  {
    $attemptCount++
    Write-ToLog -Message "[Join AD] ($attemptCount) waiting for AD authorization, polling again in 3 seconds ..."
    Start-Sleep -Seconds 3
    $authorizationEntry = Get-ADAutomationAuthorizationEntry
  }

  # Now that we have the authorization from DynamoDB - Join AD with the information
  if ($authorizationEntry.status -eq "success")
  {

    Write-ToLog -Message "[Join AD] authorization successful. Joining AD, Domain: $AD_DOMAIN_NAME using Domain Controller: $($authorizationEntry.domain_controller), Hostname: $($authorizationEntry.hostname) in OU: $($authorizationEntry.ou) ..."

    $joinCred = New-Object pscredential -ArgumentList ([pscustomobject]@{
      UserName = $null
      Password = (ConvertTo-SecureString -String $($authorizationEntry.otp) -AsPlainText -Force)[0]
    })

    # Add-Computer takes the settings as parameter values (splatting), so the domain, the domain
    # controller and the OU are data and never part of a command line
    $joinOptions = 'UnsecuredJoin, PasswordPass'
    $joinArgs = @{
        Force = $true
        DomainName = $AD_DOMAIN_NAME
        Credential = $joinCred
        Server = $authorizationEntry.domain_controller
        PassThru = $true
        ErrorVariable = '+domainJoinError'
        Verbose = $true
    }

    # OU supplied by cluster-manager

    if ($($authorizationEntry.ou) -ne $null -and $($authorizationEntry.ou) -ne '' )
    {
        Write-ToLog -Message "[Join AD] Adding to OUPath: $($authorizationEntry.ou)"
        $joinArgs.OUPath = $authorizationEntry.ou
    } else {
        Write-ToLog -Message "[Join AD] No OU supplied by cluster-manager. Using domain defaults"
    }

    # hostname supplied by cluster-manager

    if ($($authorizationEntry.hostname) -ne $env:COMPUTERNAME )
    {
        # The account was preset under this name. Add-Computer -NewName joins under the
        # current EC2AMAZ-* name, which has no preset account, so the unsecured join falls
        # back to authenticating and fails ("NTLM authentication has been disabled" on 2025,
        # "only allowed for the Primary Domain Controller" on 2019). Rename-Computer without a
        # restart sets the pending name, and JoinWithNewName joins under it: one restart
        # applies both.
        Write-ToLog -Message "[Join AD] Joining with cluster-manager supplied hostname: $($authorizationEntry.hostname)"
        Rename-Computer -NewName $($authorizationEntry.hostname) -Force -WarningAction SilentlyContinue
        $joinOptions += ', JoinWithNewName'
    }

    $joinArgs.Options = $joinOptions
    Write-ToLog -Message "[Join AD] Joining domain $AD_DOMAIN_NAME through $($authorizationEntry.domain_controller) with options $joinOptions"

    $attemptNumber = 0
    $joined = $false
    # the join names the domain controller that created the account, so the first attempt
    # needs no replication delay; a failed attempt retries every 5 s within the same overall
    # wait the retry settings allowed (a fixed 30 s sleep cost a desktop 30 s per retry)
    $joinDeadline = (Get-Date).AddSeconds([int]$AD_JOIN_RETRY_COUNT * [int]$AD_JOIN_MAX_SLEEP)
    Write-ToLog -Message "[Join AD] Retrying a failed join every 5 seconds until $joinDeadline"

    # AD Join retry loop
    do {
        $attemptNumber++
        if ($attemptNumber -gt 1) {
            Write-ToLog -Message "[Join AD] Attempt #$attemptNumber - retrying in 5 seconds after the failed attempt"
            Start-Sleep -Seconds 5
        }
        Write-ToLog -Message "[Join AD] Attempt #$attemptNumber - Proceeding with AD join"

        $joinResult = Add-Computer @joinArgs

        # only a result that reports success is a join: no result at all is a failure
        $joined = ($null -ne $joinResult) -and ($joinResult.HasSucceeded -eq $true)
        if (-not $joined) {
            Write-ToLog -Message "[Join AD] Attempt #$attemptNumber - ERROR - $joinResult"

            if ($domainJoinError) {
                Write-ToLog -Message "[Join AD] Attempt #$attemptNumber - joinResult - $joinResult"
                Write-ToLog -Message "[Join AD] Attempt #$attemptNumber - Error - $Error"
                Write-ToLog -Message "[Join AD] Attempt #$attemptNumber - domainJoinError - $domainJoinError"
            }
        } else {
            Write-ToLog -Message "[Join AD] Attempt #$attemptNumber - SUCCESS - $joinResult"
        }


    } While ( ($joined -eq $false) -and ((Get-Date) -lt $joinDeadline) )

    # Configure writes its repeat-run marker only after a join that succeeded
    $global:IdeaDomainJoined = $joined
    Write-ToLog -Message "[Join AD] ------====== AD Join Summary ======------"
    Write-ToLog -Message "[Join AD] Attempts - $attemptNumber"
    Write-ToLog -Message "[Join AD] joinResult - $joinResult"
    if ($domainJoinError) {
        Write-ToLog -Message "[Join AD] domainJoinError - $domainJoinError"
    }
    if (-not $joined) {
        throw "the domain join did not succeed after $attemptNumber attempts"
    }

  } elseif ($null -eq $authorizationEntry) {
    throw "no authorization for the domain join arrived before the deadline"
  } else {
    throw "authorization for the domain join failed: ($($authorizationEntry.error_code)) $($authorizationEntry.message)"
  }

}

function Join-IdeaDirectory
{
  <#
      .SYNOPSIS
          Request the computer account and join the domain with the transcript off, since the join
          handles the one-time join password. The transcript resumes on every path; an error
          stops the bootstrap before the desktop reports ready, and only its message is logged.
  #>
  Param(
    [Parameter(Mandatory = $true)] [string] $Hostname,
    [Parameter(Mandatory = $true)] [string] $TranscriptPath
  )
  $failure = $null
  Stop-Transcript | Out-Null
  try {
    Start-ADAutomationAuthorization -Hostname $Hostname
    Start-ADAutomationWaitForAuthorizationAndJoin
  } catch {
    $failure = $_.Exception.Message
  } finally {
    Start-Transcript -Path $TranscriptPath -Append | Out-Null
  }
  if ($failure) {
    Write-ToLog -Message "[Join AD] the directory join stopped with an error, the desktop is not configured: $failure" -Level 'Error'
    exit 1
  }
}

# End: Join ActiveDirectory (PowerShell/Windows)
