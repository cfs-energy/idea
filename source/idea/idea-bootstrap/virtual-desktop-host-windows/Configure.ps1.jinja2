# Get AWS region and account info for hostname generation
$AWS_REGION = '{{ ps_text(context.config.get_string('cluster.aws.region', required=True)) }}'
$AWS_ACCOUNT = '{{ ps_text(context.config.get_string('cluster.aws.account_id', required=True)) }}'
$CLUSTER_NAME = '{{ ps_text(context.config.get_string('cluster.cluster_name', required=True)) }}'
$HOSTNAME_PREFIX = '{{ ps_text(context.config.get_string('directoryservice.ad_automation.hostname_prefix', default='IDEA-')) }}'

# Generate hostname using the IDEA algorithm
function Get-IdeaHostname {
    # Check if prefix is too long (leaves less than 4 chars for the random part)
    $avail_chars = 15 - $HOSTNAME_PREFIX.Length
    if ($avail_chars -lt 4) {
        Write-ToLog -Message "Hostname prefix $HOSTNAME_PREFIX is too long. It must leave at least 4 characters for random data."
        throw "Hostname prefix is too long"
    }

    # Create the input string
    $hostname_data = "$AWS_REGION|$AWS_ACCOUNT|$CLUSTER_NAME|$InstanceId"
    Write-ToLog -Message "Using hostname data: $hostname_data with prefix: $HOSTNAME_PREFIX (available chars: $avail_chars)"

    # Create SHA256 hash
    $sha = [System.Security.Cryptography.SHA256]::Create()
    $bytes = [System.Text.Encoding]::UTF8.GetBytes($hostname_data)
    $hash_bytes = $sha.ComputeHash($bytes)
    $hash = [BitConverter]::ToString($hash_bytes).Replace("-", "").ToLower()

    # Take the last n characters
    $shake_value = $hash.Substring($hash.Length - $avail_chars)
    $idea_hostname = "$HOSTNAME_PREFIX$shake_value".ToUpper()

    Write-ToLog -Message "Generated IDEA hostname: $idea_hostname"
    return $idea_hostname
}

function New-LocalPassword {
    # 24 characters from the OS CSPRNG (rejection sampling keeps them uniform), drawn again until
    # the Windows complexity policy accepts it: all four character classes, and no account name
    Param([Parameter(Mandatory=$true)] [String] $UserName)
    $Alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!#%+-.:=?@^_~'
    $Limit = 256 - (256 % $Alphabet.Length)
    $Rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
    $Byte = New-Object byte[] 1
    do {
        $Chars = for ($i = 0; $i -lt 24; $i++) {
            do { $Rng.GetBytes($Byte) } while ($Byte[0] -ge $Limit)
            $Alphabet[$Byte[0] % $Alphabet.Length]
        }
        $Password = -join $Chars
    } until ($Password -cmatch '[A-Z]' -and $Password -cmatch '[a-z]' -and $Password -match '[0-9]' -and
             $Password -match '[^A-Za-z0-9]' -and $Password.IndexOf($UserName, [StringComparison]::OrdinalIgnoreCase) -lt 0)
    $Rng.Dispose()
    $Password
}

function Set-AutoLogonPassword {
    # Stores the auto-logon password as the LSA secret Winlogon reads, instead of the
    # Winlogon DefaultPassword registry value, which holds it in clear text
    Param([Parameter(Mandatory=$true)] [String] $Password)
    Add-Type -TypeDefinition @'
using System;
using System.ComponentModel;
using System.Runtime.InteropServices;
public static class IdeaLsaSecret {
    [StructLayout(LayoutKind.Sequential)]
    struct LSA_UNICODE_STRING { public ushort Length; public ushort MaximumLength; public IntPtr Buffer; }
    [StructLayout(LayoutKind.Sequential)]
    struct LSA_OBJECT_ATTRIBUTES { public int Length; public IntPtr RootDirectory; public IntPtr ObjectName; public uint Attributes; public IntPtr SecurityDescriptor; public IntPtr SecurityQualityOfService; }
    [DllImport("advapi32.dll")] static extern uint LsaOpenPolicy(IntPtr SystemName, ref LSA_OBJECT_ATTRIBUTES ObjectAttributes, uint DesiredAccess, out IntPtr PolicyHandle);
    [DllImport("advapi32.dll")] static extern uint LsaStorePrivateData(IntPtr PolicyHandle, ref LSA_UNICODE_STRING KeyName, ref LSA_UNICODE_STRING PrivateData);
    [DllImport("advapi32.dll")] static extern uint LsaClose(IntPtr PolicyHandle);
    [DllImport("advapi32.dll")] static extern int LsaNtStatusToWinError(uint Status);
    static LSA_UNICODE_STRING Unicode(string value) {
        LSA_UNICODE_STRING s = new LSA_UNICODE_STRING();
        s.Buffer = Marshal.StringToHGlobalUni(value);
        s.Length = (ushort)(value.Length * 2);
        s.MaximumLength = (ushort)(value.Length * 2 + 2);
        return s;
    }
    public static void Store(string key, string value) {
        LSA_OBJECT_ATTRIBUTES attributes = new LSA_OBJECT_ATTRIBUTES();
        attributes.Length = Marshal.SizeOf(typeof(LSA_OBJECT_ATTRIBUTES));
        IntPtr policy;
        uint status = LsaOpenPolicy(IntPtr.Zero, ref attributes, 0x20 /* POLICY_CREATE_SECRET */, out policy);
        if (status != 0) throw new Win32Exception(LsaNtStatusToWinError(status));
        LSA_UNICODE_STRING name = Unicode(key);
        LSA_UNICODE_STRING data = Unicode(value);
        try {
            status = LsaStorePrivateData(policy, ref name, ref data);
            if (status != 0) throw new Win32Exception(LsaNtStatusToWinError(status));
        } finally {
            Marshal.ZeroFreeGlobalAllocUnicode(data.Buffer);
            Marshal.FreeHGlobal(name.Buffer);
            LsaClose(policy);
        }
    }
}
'@
    [IdeaLsaSecret]::Store('DefaultPassword', $Password)
}

function Set-IdeaLocalAccounts {
    # Both local passwords are made here at first boot and kept only in memory, the SAM and the
    # LSA secret store: the package is built on the controller and must carry no secret. The
    # transcript is off while a password is in a variable and resumes on every path. A failure
    # stops the bootstrap before the desktop reports ready; only the error message is logged.
    Param(
        [Parameter(Mandatory=$true)] [String] $LocalUser,
        [Parameter(Mandatory=$true)] [String] $TranscriptPath
    )
    $ErrorActionPreference = 'Stop'
    $Failure = $null
    try { Stop-Transcript | Out-Null } catch { }
    try {
        $LocalPasswordInput = New-LocalPassword -UserName $LocalUser
        $LocalPassword = ConvertTo-SecureString -String $LocalPasswordInput -AsPlainText -Force
        if (Get-LocalUser -Name $LocalUser -ErrorAction SilentlyContinue) {
            Set-LocalUser -Name $LocalUser -Password $LocalPassword
        } else {
            New-LocalUser -Name $LocalUser -Password $LocalPassword -PasswordNeverExpires -AccountNeverExpires | Out-Null
        }
        # The Administrators group and the built-in administrator are found by their well-known
        # SIDs (S-1-5-32-544, RID 500): their names differ on localized and hardened images.
        try {
            Add-LocalGroupMember -SID 'S-1-5-32-544' -Member $LocalUser
            Write-ToLog -Message "Added $LocalUser to the Administrators group"
        } catch {
            if ($_.FullyQualifiedErrorId -notlike 'MemberExists*') { throw }
        }

        # Auto-logon signs the owner in to the console session DCV serves. Winlogon reads the
        # password from the LSA secret DefaultPassword; the registry value is readable by every
        # local account, so a value left by an image made from an older desktop is removed.
        $Winlogon = 'HKLM:\Software\Microsoft\Windows NT\CurrentVersion\Winlogon'
        Remove-ItemProperty -Path $Winlogon -Name 'DefaultPassword' -ErrorAction SilentlyContinue
        Set-AutoLogonPassword -Password $LocalPasswordInput
        New-ItemProperty -Path $Winlogon -Name 'AutoAdminLogon' -PropertyType 'DWord' -Value 1 -Force | Out-Null
        New-ItemProperty -Path $Winlogon -Name 'DefaultUserName' -PropertyType 'String' -Value $LocalUser -Force | Out-Null

        # The owner is a local administrator, so nothing needs the built-in administrator's
        # password: it is replaced with one nobody is told.
        $BuiltInAdmin = Get-LocalUser | Where-Object { "$($_.SID)" -like 'S-1-5-21-*-500' } | Select-Object -First 1
        if ($BuiltInAdmin) {
            $AdminPassword = ConvertTo-SecureString -String (New-LocalPassword -UserName $BuiltInAdmin.Name) -AsPlainText -Force
            $BuiltInAdmin | Set-LocalUser -Password $AdminPassword
        } else {
            Write-ToLog -Message 'This image has no built-in administrator account (RID 500); no administrator password was changed' -Level 'Warn'
        }
    } catch {
        $Failure = $_.Exception.Message
    } finally {
        Remove-Variable LocalPasswordInput, LocalPassword, AdminPassword -ErrorAction SilentlyContinue
        Start-Transcript -Path $TranscriptPath -Append | Out-Null
    }
    if ($Failure) {
        Write-ToLog -Message "Local account setup for $LocalUser stopped with an error, the desktop is not configured: $Failure" -Level 'Error'
        exit 1
    }
    Write-ToLog -Message "Set first-boot passwords for $LocalUser (auto-logon)$(if ($BuiltInAdmin) { " and $($BuiltInAdmin.Name)" })"
}

function Install-OwnerPasswordScript {
    # Nobody is told the first-boot password, so the owner sets their own from inside the session
    # to unlock the desktop or sign back in: a shortcut on the public desktop runs this script
    # elevated (the owner is a local administrator). It sets the account password and, for the
    # auto-logon account, the LSA secret Winlogon reads, so a restart still signs the owner in.
    $ScriptsDirectory = 'C:\IDEA\LocalScripts'
    $ScriptPath = "$ScriptsDirectory\Set-MyWindowsPassword.ps1"
    $Body = @'
$ErrorActionPreference = 'Stop'
$First = Read-Host -AsSecureString "New Windows password for $env:USERNAME"
$Second = Read-Host -AsSecureString 'Type the same password again'
$Plain = [Net.NetworkCredential]::new('', $First).Password
if ($Plain -cne [Net.NetworkCredential]::new('', $Second).Password) {
    Write-Host 'The two passwords differ; nothing was changed.'
    exit 1
}
Set-LocalUser -Name $env:USERNAME -Password $First
$Winlogon = 'HKLM:\Software\Microsoft\Windows NT\CurrentVersion\Winlogon'
if ((Get-ItemProperty -Path $Winlogon -Name 'DefaultUserName' -ErrorAction SilentlyContinue).DefaultUserName -eq $env:USERNAME) {
    Set-AutoLogonPassword -Password $Plain
}
Remove-Variable Plain, First, Second
Write-Host 'Your password is set. Use it to unlock this desktop or to sign back in.'
'@
    $Content = "function Set-AutoLogonPassword {`r`n" + ${function:Set-AutoLogonPassword}.ToString() + "`r`n}`r`n" + $Body
    [IO.Directory]::CreateDirectory($ScriptsDirectory) | Out-Null
    [IO.File]::WriteAllText($ScriptPath, $Content)
    $Shell = New-Object -ComObject WScript.Shell
    $Shortcut = $Shell.CreateShortcut("$env:PUBLIC\Desktop\Set my Windows password.lnk")
    $Shortcut.TargetPath = 'powershell.exe'
    $Shortcut.Arguments = "-NoProfile -ExecutionPolicy Bypass -Command `"Start-Process powershell.exe -Verb RunAs -ArgumentList '-NoProfile -ExecutionPolicy Bypass -NoExit -File $ScriptPath'`""
    $Shortcut.Save()
}


function Configure-WindowsEC2Instance {

  $timestamp = Get-Date -Format 'yyyyMMddTHHmmssffffZ'
  $ConfigureEVDI = "$env:SystemDrive\Users\Administrator\IDEA\bootstrap\log\ConfigureEVDI.log.$timestamp"

  Start-Transcript -Path $ConfigureEVDI -NoClobber -IncludeInvocationHeader

  # Creating unique hostname to avoid NETBIOS name conflict when using an existing AMI
  [string]$IMDS_Token = Invoke-RestMethod -Headers @{"X-aws-ec2-metadata-token-ttl-seconds" = "600"} -Method PUT -Uri http://169.254.169.254/latest/api/token
  $InstanceType = Invoke-RestMethod -Headers @{"X-aws-ec2-metadata-token" = $IMDS_Token} -Method GET -Uri http://169.254.169.254/latest/meta-data/instance-type
  $InstanceId = Invoke-RestMethod -Headers @{"X-aws-ec2-metadata-token" = $IMDS_Token} -Method GET -Uri http://169.254.169.254/latest/meta-data/instance-id
  # EC2Launch v2 records a finished user data run only after its postReady stage, and the
  # restart at the end of this function can take the agent down first: the next boot
  # then runs all of the user data again (Windows Server 2019: about 2 minutes and a second
  # reboot after IDEA_BOOTSTRAP_COMPLETE). Once this instance has finished, a repeat is a no-op.
  $ConfiguredMarker = "$env:SystemDrive\ProgramData\IDEA\configured-$InstanceId"
  if (Test-Path $ConfiguredMarker) {
    Write-ToLog -Message "Instance $InstanceId is already configured; skipping the repeated user data run"
    Stop-Transcript
    exit 0
  }
  # flip below lines if you want to enable/disable computer renaming
  $DesktopHostname = Get-IdeaHostname
  # $DesktopHostname = $InstanceId.substring($InstanceId.length - 15, 15).ToUpper()
  {% if context.config.get_string('directoryservice.provider', required=True) in ['aws_managed_activedirectory', 'activedirectory'] %}
  # The domain join below renames the computer (Rename-Computer + JoinWithNewName), and the restart at
  # the end applies both: a rename restart first cost every desktop a full extra boot.
  $RenameFirst = $false
  {% else %}
  $RenameFirst = $env:COMPUTERNAME -ne $DesktopHostname
  {% endif %}
  if ($RenameFirst) {
    Write-ToLog -Message "Hostname detected $env:COMPUTERNAME . Renaming Computer to $DesktopHostname ..."
    Rename-Computer -NewName $DesktopHostname -Force
    Write-ToLog -Message "Name has been changed, re-enabling user data as we are about to restart the system ..."

    # Check Windows version and use appropriate method for re-enabling user data
    if (Test-Path 'C:\Program Files\Amazon\EC2Launch\EC2Launch.exe') {
        # Use the installed agent, including sysprepped Windows Server 2019 images.
        Write-ToLog -Message "Using installed EC2Launch v2"
        & "C:\Program Files\Amazon\EC2Launch\EC2Launch.exe" reset
    } else {
        # Older Windows versions - uses EC2Launch v1
        Write-ToLog -Message "Windows Server pre-2022 detected, using EC2Launch v1"
        & C:\ProgramData\Amazon\EC2-Windows\Launch\Scripts\InitializeInstance.ps1 -Schedule
    }

    Write-ToLog -Message "Restarting Computer ..."
    Stop-Transcript
    Restart-Computer -Force
    exit
  }

  $IDEASessionID = '{{ ps_text(context.vars.idea_session_id) }}'
  $LocalUser = '{{ ps_text(context.vars.session_owner) }}'
  $VdcRequestQueueURL = '{{ ps_text(context.config.get_string('virtual-desktop-controller.events_sqs_queue_url', required=True)) }}'
  $IdeaWebPortalURL = '{{ ps_text(context.config.get_cluster_external_endpoint()) }}'

  # Earlier releases left the local passwords in the Winlogon DefaultPassword value (readable by
  # every local account) and in this file. An image taken from such a desktop carries both, on
  # either directory provider, so both are removed here.
  Remove-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows NT\CurrentVersion\Winlogon' -Name 'DefaultPassword' -ErrorAction SilentlyContinue
  Remove-Item 'C:\LOCAL_ADMINS_PASSWORD.txt' -Force -ErrorAction SilentlyContinue

  {% if context.config.get_string('directoryservice.provider', required=True) in ['aws_managed_activedirectory', 'activedirectory'] %}
  $ServerInAD = (Get-WmiObject -Class Win32_ComputerSystem).PartOfDomain
  if ($ServerInAD -and $env:COMPUTERNAME -ne $DesktopHostname) {
    # A desktop from a "Create Stack from Session" image boots already joined under the source
    # desktop's name and machine account. As in earlier releases the join is skipped and the
    # desktop keeps that identity; the shared machine account is reported so it can be traced.
    Write-ToLog -Message "This instance is already joined to the domain as $env:COMPUTERNAME, an identity it took from its image (this desktop's own name would be $DesktopHostname); it shares that computer account with the source desktop. The join is skipped." -Level 'Warn'
  }
  $DomainUserName = '{{ ps_text(context.config.get_string('directoryservice.ad_short_name', required=True)) }}\' + $LocalUser
  if ($ServerInAD -eq $false)
  {
    Join-IdeaDirectory -Hostname $DesktopHostname -TranscriptPath $ConfigureEVDI

    New-ItemProperty -Path "HKLM:\Software\Microsoft\Windows NT\CurrentVersion\Winlogon" -Name "AutoAdminLogon" -PropertyType "DWord" -Value 1 -Force
    New-ItemProperty -Path "HKLM:\Software\Microsoft\Windows NT\CurrentVersion\Winlogon" -Name "DefaultUserName" -PropertyType "String" -Value $DomainUserName -Force
  }
  {% else %}
  # Avoid to hit race condition after the Restart-Computer
  Start-Sleep -Seconds 5
  Write-ToLog -Message "Creating new local IDEA user: $LocalUser"
  $DomainUserName = $LocalUser
  Set-IdeaLocalAccounts -LocalUser $LocalUser -TranscriptPath $ConfigureEVDI
  Install-OwnerPasswordScript
  {% endif %}

  # Disable User Access Control (UAC)"
  Set-ItemProperty "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" -Name "ConsentPromptBehaviorAdmin" -Value 00000000 -Force

  # "Disable Internet Explorer Enhanced Security Configuration"
  $AdminKey = "HKLM:\SOFTWARE\Microsoft\Active Setup\Installed Components\{A509B1A7-37EF-4b3f-8CFC-4F3A74704073}"
  $UserKey = "HKLM:\SOFTWARE\Microsoft\Active Setup\Installed Components\{A509B1A8-37EF-4b3f-8CFC-4F3A74704073}"
  Set-ItemProperty -Path $AdminKey -Name "IsInstalled" -Value 0 -Force
  Set-ItemProperty -Path $UserKey -Name "IsInstalled" -Value 0 -Force

  Write-ToLog -Message "Create Shortcut to IDEA web interface"
  $WshShell = New-Object -comObject WScript.Shell
  $DefaultDesktopDir = "C:\Users\Default\Desktop"
  New-Item -ItemType Directory -Path $DefaultDesktopDir -Force
  $IdeaShortcutAdmin = $WshShell.CreateShortcut("$DefaultDesktopDir\IDEA_Interface.url")
  $IdeaShortcutAdmin.TargetPath = "$IdeaWebPortalURL"
  $IdeaShortcutAdmin.Save()

  $instanceInfo = aws ec2 describe-instance-types --instance-types $InstanceType --output json | ConvertFrom-Json
  if ($instanceInfo.InstanceTypes.GpuInfo) {
    $gpu = $instanceInfo.InstanceTypes.GpuInfo.Gpus | ForEach-Object { $_.Manufacturer }
    if ($gpu -eq "NVIDIA") {
        Write-ToLog -Message "Detected NVIDIA GPU"
        {% include  "_templates/windows/gpu/nvidia_drivers.jinja2" %}
    } elseif ($gpu -eq "AMD")
    {
        Write-ToLog -Message "Detected AMD GPU"
        {% include  "_templates/windows/gpu/amd_drivers.jinja2" %}
    }
    else
    {
        Write-ToLog -Message "GPU detected but manufacturer is not NVIDIA or AMD, detected ${gpu}, skipping .."
    }
  } else {
      Write-ToLog -Message "No GPU detected on this machine"
  }

  Write-ToLog -Message "Configuring instance storage (if available)"
  Configure-InstanceStorage

  Write-ToLog -Message "Tagging EBS Volumes"
  Tag-EbsVolumes

  Write-ToLog -Message "Tagging Network Interface"
  Tag-NetworkInterface

  Write-ToLog -Message "mount any applicable shared storage file systems"
  Mount-SharedStorage -DomainUserName $DomainUserName

  Write-ToLog -Message "Install and Configure NICE DCV"
  Import-Module .\ConfigureDCVHost.ps1
  Bootstrap-DCV-WindowsHost

  Configure-DCVPermissions

  $RebootNotificationContent = "
`$CurrentTimeStamp = [DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds()
`$RebootMessage = `"{```"event_group_id```":```"$IDEASessionID```",```"event_type```":```"DCV_HOST_REBOOT_COMPLETE_EVENT```",```"detail```":{```"idea_session_id```":```"$IDEASessionID```",```"idea_session_owner```":```"$LocalUser```",```"timestamp```":```"`$CurrentTimeStamp```"}}`"
# todo - support vpc endpoint
Send-SQSMessage -QueueUrl $VdcRequestQueueURL -MessageBody `$RebootMessage -MessageGroupId $IDEASessionID
"
  $IdeaScriptsDirectory = "C:\IDEA\LocalScripts"
  New-Item -Path $IdeaScriptsDirectory -Name "IdeaRebootNotification.ps1" -ItemType File -Force -Value "$RebootNotificationContent"
  schtasks /create /sc onstart /tn IdeaRebootNotification /tr "powershell -ExecutionPolicy Bypass -File $IdeaScriptsDirectory\IdeaRebootNotification.ps1" /ru system /f
  schtasks /create /sc onevent /ec system /mo "*[System[Provider[@Name='Microsoft-Windows-Power-Troubleshooter'] and (Level=4 or Level=0) and (EventID=1)]]"  /tn IDEAWakeupNotification /tr "powershell -ExecutionPolicy Bypass -File $IdeaScriptsDirectory\IdeaRebootNotification.ps1" /ru system /f
  $Message = "{{ context.vars.dcv_host_ready_message }}"
  # todo - support vpc endpoint
  # image validation reads this line from the bootstrap_<instance id> CloudWatch stream;
  {% if context.config.get_string('directoryservice.provider', required=True) in ['aws_managed_activedirectory', 'activedirectory'] %}
  # a desktop that is not in the domain never reports ready, and gets no repeat-run marker
  if (-not ($ServerInAD -or $global:IdeaDomainJoined)) {
    Write-ToLog -Message "Instance $InstanceId is not joined to the domain; the desktop is not configured" -Level 'Error'
    exit 1
  }
  {% endif %}
  # written before the restart below so the agent ships it first
  Write-ToLog -Message "IDEA_BOOTSTRAP_COMPLETE release={{ context.module_version }}"
  Send-SQSMessage -QueueUrl $VdcRequestQueueURL -MessageBody $Message -MessageGroupId $IDEASessionID
  [IO.Directory]::CreateDirectory((Split-Path $ConfiguredMarker)) | Out-Null
  [IO.File]::WriteAllText($ConfiguredMarker, "{{ context.module_version }}")

  Stop-Transcript
  Restart-Computer -Force
  exit
}
