{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "pip_requirements": {
    "fileMatch": [
      "requirements\\/.*\\.(in)$"
    ]
  },
  "labels": [
    "renovate"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "pypi"
      ],
      "labels": [
        "python"
      ]
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "labels": [
        "node"
      ]
    },
    {
      "matchDepTypes": [
        "optionalDependencies"
      ],
      "addLabels": [
        "optional"
      ]
    }
  ]
}
