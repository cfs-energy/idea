{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "America/New_York",
  "schedule": [
    "* 0-6 * * 1"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 2,
  "branchConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "vulnerabilityAlerts": {
    "enabled": true,
    "prConcurrentLimit": 5
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-6 * * 1"
    ],
    "groupName": "all dependencies",
    "groupSlug": "all-dependencies"
  },
  "pip_requirements": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^software_versions\\.yml$"
      ],
      "matchStrings": [
        "node_version:\\s*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "fileMatch": [
        "^software_versions\\.yml$"
      ],
      "matchStrings": [
        "python_version:\\s*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version"
    },
    {
      "customType": "regex",
      "fileMatch": [
        "^software_versions\\.yml$"
      ],
      "matchStrings": [
        "nvm_version:\\s*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "nvm-sh/nvm",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "labels": [
    "renovate"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "pypi"
      ],
      "labels": [
        "python"
      ]
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "labels": [
        "node"
      ]
    },
    {
      "matchDepTypes": [
        "optionalDependencies"
      ],
      "addLabels": [
        "optional"
      ]
    },
    {
      "matchManagers": [
        "pip-compile"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "description": "Every scheduled update lands in one pull request, majors included; vulnerability alerts stay separate and immediate",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest",
        "rollback",
        "replacement"
      ],
      "groupName": "all dependencies",
      "groupSlug": "all-dependencies"
    }
  ],
  "pip-compile": {
    "fileMatch": [
      "^requirements/[^/]+\\.txt$"
    ]
  },
  "separateMajorMinor": false,
  "separateMultipleMajor": false
}
