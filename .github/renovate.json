{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "America/New_York",
  "schedule": [
    "* 0-6 * * 1"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 2,
  "branchConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "vulnerabilityAlerts": {
    "enabled": true,
    "prConcurrentLimit": 5
  },
  "pip_requirements": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^software_versions\\.yml$"
      ],
      "matchStrings": [
        "node_version:\\s*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "fileMatch": [
        "^software_versions\\.yml$"
      ],
      "matchStrings": [
        "python_version:\\s*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version"
    },
    {
      "customType": "regex",
      "fileMatch": [
        "^software_versions\\.yml$"
      ],
      "matchStrings": [
        "nvm_version:\\s*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "nvm-sh/nvm",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "labels": [
    "renovate"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "pypi"
      ],
      "labels": [
        "python"
      ]
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "labels": [
        "node"
      ]
    },
    {
      "matchDepTypes": [
        "optionalDependencies"
      ],
      "addLabels": [
        "optional"
      ]
    },
    {
      "matchManagers": [
        "pip-compile"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "description": "Every scheduled minor, patch, pin and digest update lands in one pull request; majors arrive one per dependency so each can be judged on its own; vulnerability alerts stay separate and immediate",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest",
        "rollback",
        "replacement"
      ],
      "groupName": "all dependencies",
      "groupSlug": "all-dependencies"
    },
    {
      "description": "Platform pins move deliberately: the Node line of the tool, image and release files, the base image, the CI runner images and the JDK are bumped by hand in their own change, never by the weekly run. Patch releases within the pinned line still flow",
      "matchDepNames": [
        "node",
        "public.ecr.aws/amazonlinux/amazonlinux",
        "ubuntu",
        "java-jdk",
        "python"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    }
  ],
  "pip-compile": {
    "fileMatch": [
      "^requirements/[^/]+\\.txt$"
    ]
  },
  "separateMajorMinor": true,
  "separateMultipleMajor": false,
  "lockFileMaintenance": {
    "enabled": false
  }
}
